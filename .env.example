# Trader-IA configuration template.
#
# Copy to .env and fill in. .env is gitignored; this file is not, so NOTHING REAL GOES
# HERE. Every value below is a placeholder or a safe default.
#
#   cp .env.example .env
#
# Nesting uses a double underscore: TIA_LIVE__MAX_LIVE_CAPITAL maps to live.max_live_capital.
# Anything left unset falls back to the default in packages/tia/src/tia/core/config.py,
# and the defaults are the safe end of every range.


# ---------------------------------------------------------------------------- profile

# demo | development | testing | paper | shadow | backtest
# demo runs with no credentials and no network at all.
TIA_ENV=demo

# backtest | paper | shadow | research | live
# NOTE: mode=live does NOT enable live trading. It is a statement of intent. Execution
# requires the activation gate to pass every check and a human to type a confirmation
# phrase. No value in this file can substitute for either.
TIA_MODE=paper

# Root seed for every derived RNG stream. Same seed + same inputs = same run.
TIA_SEED=20260812

# Paper/backtest starting capital. Not real money; see TIA_LIVE__MAX_LIVE_CAPITAL below
# for the number that governs real money.
TIA_INITIAL_CAPITAL=100000


# ---------------------------------------------------------------------------- storage

TIA_DATABASE_URL=sqlite+aiosqlite:///./data/runtime/tia.db

# memory | redis. Redis is only needed for multi-process deployments.
TIA_EVENT_BUS=memory
# TIA_REDIS_URL=redis://localhost:6379/0


# ---------------------------------------------------------------------------- security

# CHANGE THIS. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left unset (or on the placeholder), the API signs sessions with a per-process random
# secret: safe, but every restart logs everyone out. Set it and sessions survive restarts.
TIA_SECURITY__JWT_SECRET=generate-your-own-do-not-use-this-value

TIA_SECURITY__JWT_TTL_SECONDS=3600
TIA_SECURITY__API_RATE_LIMIT_PER_MINUTE=240


# ---------------------------------------------------------------------------- market data

# synthetic | csv | binance
# synthetic needs no network. binance reads public endpoints only — no key, no signature.
TIA_MARKET_DATA__PROVIDER=synthetic
TIA_MARKET_DATA__TIMEFRAME=1m


# ---------------------------------------------------------------------------- LLM

# The AI layer is optional and is never on the critical path of a decision. With
# provider=stub it runs fully offline; its output can only ever *reduce* confidence,
# never raise it.
TIA_LLM__ENABLED=false
TIA_LLM__PROVIDER=stub
# TIA_ANTHROPIC_API_KEY=sk-ant-...
TIA_LLM__MAX_COST_USD_PER_DAY=25


# ---------------------------------------------------------------------------- live trading
#
# Everything in this block is OFF by default and stays off until you deliberately change
# it. Read docs/LIVE_TRADING.md before touching any of it.
#
# What this system can and cannot do with your Binance account:
#
#   CAN     read prices, read your balance, place and cancel spot orders
#   CANNOT  withdraw, transfer, or move funds anywhere — there is no code path for it,
#           and the API key must not have the permission either
#
# Your money never leaves Binance. This application has no wallet, holds no funds, and
# never receives a deposit.

# Whether the live path may be considered at all. False disables the activation endpoint.
TIA_LIVE__ENABLED=false

# The most that may EVER be at work, in USDT. Everything in your Binance account above
# this is out of reach by construction. There is no default: leaving it at 0 means the
# activation gate cannot arm. Start small — an amount you would be entirely fine losing.
TIA_LIVE__MAX_LIVE_CAPITAL=0

TIA_LIVE__SYMBOL=BTC-USD

# conservative | balanced | aggressive
# 0.25% / 0.50% / 1.00% of equity risked per trade at full budget.
TIA_LIVE__RISK_PROFILE=conservative

# Minimum net edge in basis points, after fees, spread, slippage and latency, before a
# trade is worth taking. Below this the system reports NO_TRADE and explains why.
TIA_LIVE__EV_THRESHOLD_BPS=5

# Paper-only exploration budget: trades per UTC day the 24/7 session may take in buckets
# the estimator has NO evidence for, or whose edge is UNPROVEN (positive on average but
# not yet clear of its own uncertainty), purely to buy lessons with simulated money at a
# reduced size. It never trades a bucket the evidence says loses, never crosses a learning
# guardrail, never counts toward the real-money track record, and is ignored outright over
# a live execution provider regardless of this value. 0 disables.
TIA_LIVE__EXPLORATION_TRADES_PER_DAY=12

# How the session enters: market (cross the spread, taker fee) or limit (rest at the
# touch, maker fee, no spread crossed — about half the round-trip cost). A resting entry
# unfilled after this many bars is cancelled; an expired exit is re-sent as market.
TIA_LIVE__ENTRY_ORDER_TYPE=limit
TIA_LIVE__ENTRY_LIMIT_TIMEOUT_BARS=3

# Time stop: close a position still open after this many bars. 0 = off (parity with
# the evidence-producing engine). Every position is protected by a stop regardless.
TIA_LIVE__MAX_HOLDING_BARS=0

# Stop management after entry, applied identically by the paper engine and the session.
# Break-even: once the trade is this many R (initial risk) in profit, the stop moves to
# entry plus fees. Trailing: the stop follows the best price at this many ATRs. 0 = off.
TIA_LIVE__BREAKEVEN_AFTER_R=1.0
TIA_LIVE__TRAIL_ATR_MULTIPLE=2.0

# Refuse entries while the live top-of-book spread is wider than this (bps). 0 = off.
TIA_LIVE__MAX_SPREAD_BPS=10

# Conviction sizing: how much of the risk-approved size a trade takes, from the evidence.
# Never more than 100%. Strong exact evidence = full size; barely significant = the
# floor; pooled evidence capped; exploration trades are cheap lessons.
TIA_LIVE__CONVICTION_SIZING=true
TIA_LIVE__MIN_SIZE_FRACTION=0.35
TIA_LIVE__EXPLORATION_SIZE_FRACTION=0.25
TIA_LIVE__POOLED_SIZE_CAP=0.6

# Higher-timeframe trend context (the one-to-four-week momentum the literature agrees
# on, read from hourly bars). hard = refuse entries against an agreed tide; soft = halve
# their size; off = ignore. The z threshold is how strong both horizons must agree.
TIA_LIVE__HTF_MODE=hard
TIA_LIVE__HTF_Z_THRESHOLD=1.0

# The 24/7 paper session's simulated account: a leveraged perpetual account. Starts
# from PAPER_CAPITAL (the record's P&L is carried across restarts); notional capped at
# LEVERAGE x equity; liquidated below MAINTENANCE_MARGIN_PCT of open notional, at a
# fee; funding charged every 8h at the live rate. Refused over live execution.
TIA_LIVE__PAPER_CAPITAL=10000
TIA_LIVE__LEVERAGE=5
TIA_LIVE__MAINTENANCE_MARGIN_PCT=0.5
TIA_LIVE__LIQUIDATION_FEE_BPS=50
TIA_LIVE__CHARGE_FUNDING=true

# True until you have deliberately validated against the real venue. Keep it True while
# testing: testnet.binance.vision uses separate keys and separate, fake balances.
TIA_LIVE__USE_TESTNET=true

# --- Binance API credentials -------------------------------------------------
#
# DATA NEEDED     A Binance API key and secret.
# WHY             To read your balance and place spot orders on your behalf. Public
#                 market data needs neither; everything account-specific needs both.
# WHERE           Binance → Account → API Management → Create API.
#                 Then paste into .env (NOT this file, NOT the web interface, NOT chat).
# HOW TO PROTECT  When creating the key, enable ONLY:
#                     [x] Enable Reading
#                     [x] Enable Spot & Margin Trading
#                 and leave DISABLED — this is the part that matters:
#                     [ ] Enable Withdrawals
#                     [ ] Enable Internal Transfer
#                     [ ] Permits Universal Transfer
#                     [ ] Enable Futures
#                     [ ] Enable Margin
#                 Restrict the key to your server's IP address.
#                 The system verifies these permissions against Binance before it will
#                 arm, and refuses outright if the key can move funds. It does not take
#                 your word for it, and it should not take mine.
#
# Never share the secret with anyone, including in a chat with an AI assistant. Binance
# shows it exactly once at creation; if you lose it, delete the key and make a new one.
# If you ever paste it anywhere by accident, delete the key immediately — that is the
# whole remedy, and it takes thirty seconds.
#
# TIA_LIVE__BINANCE_API_KEY=
# TIA_LIVE__BINANCE_API_SECRET=

# Paper-trading evidence required before the gate's track-record check will pass.
TIA_LIVE__MIN_PAPER_DAYS=7
TIA_LIVE__MIN_PAPER_TRADES=30

# How long an activation stays valid before the gate must run again. Max 6 hours.
TIA_LIVE__ACTIVATION_TTL_SECONDS=3600


# ---------------------------------------------------------------------------- observability

TIA_OBSERVABILITY__LOG_LEVEL=INFO
# json | console
TIA_OBSERVABILITY__LOG_FORMAT=console
