# Trader-IA — production stack configuration (docker-compose.prod.yml).
#
# Copy to .env on the VPS and fill in. .env is gitignored; this file is committed, so
# NOTHING REAL GOES HERE — every value is a placeholder.
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d --build
#
# Secrets policy: credentials live in this file on the server (mode 600, owned by the
# deploy user) or in your secret manager — never in the compose file, never in the
# repository, never pasted into a chat or a shell argument.

# ---------------------------------------------------------------- required (no default)

# Postgres password for the internal database. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Dashboard operator login. The API refuses weak defaults outside demo.
TIA_DEMO_USER=
TIA_DEMO_PASSWORD=

# Session-token signing key. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
TIA_JWT_SECRET=

# ---------------------------------------------------------------- strongly recommended

# What Caddy answers as. Three valid values, in order of preference:
#   your-domain.com      -> automatic Let's Encrypt HTTPS, no browser warnings
#   this server's public IP -> self-signed cert; browsers warn once, then work
#   localhost            -> only reachable from the server itself (first smoke test)
# With the default, browsing https://<ip> from outside fails with an SSL protocol
# error, because Caddy has no certificate for a name nobody configured.
TIA_DOMAIN=localhost

# Any endpoint accepting a JSON POST: Discord/Slack webhook URL, ntfy topic, or your
# own receiver. Incidents (safe mode, kill switch, capital halts, watchdog trips) are
# pushed here. Empty = alerts stay in the database and the dashboard only.
TIA_ALERT_WEBHOOK_URL=

# How many daily database dumps to keep on the backups volume.
BACKUP_KEEP=14

# ---------------------------------------------------------------- optional

# Claude API key. Without it the offline mock runs and the advisory layer degrades
# to NO effect on risk — the trading engine does not depend on it.
TIA_ANTHROPIC_API_KEY=

# Venue credentials — NOT needed for the 24/7 paper session. Only set them when you
# are ready to run `make binance-account` / the live activation gate, and prefer a
# key restricted to: reading + spot trading, withdrawals DISABLED, IP-locked to this
# server. A key here arms nothing by itself; the gate's 27 checks still apply.
TIA_BINANCE_API_KEY=
TIA_BINANCE_API_SECRET=
