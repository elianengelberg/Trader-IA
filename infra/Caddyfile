# Reverse proxy for the production stack. One site, one upstream.
#
# TIA_DOMAIN=localhost (the default) serves HTTPS with Caddy's own local CA —
# fine for a first boot and for `make production-readiness`. A real domain whose
# DNS points at this machine gets automatic Let's Encrypt certificates, renewal
# included, with no further configuration. TIA_DOMAIN can also be the server's
# public IP: self-signed cert, browsers warn once.

{
	# Browsers and curl send no SNI when the address is a bare IP, and without
	# SNI Caddy cannot pick a certificate — the handshake dies with
	# "tlsv1 alert internal error" even though the IP's cert was issued fine.
	# Found on the first real deployment. Harmless with a domain (clients
	# send SNI then, and this default never applies).
	default_sni {$TIA_DOMAIN:localhost}
}

# Anything that arrives by bare address — the old bookmark, the raw IP, a plain http://
# link — is sent to the name. Before this, a request whose Host matched no site block got
# Caddy's empty 200: a blank page that some browsers offered as a "document.txt" download,
# which read as the site installing something. The raw IP over HTTPS still shows a
# certificate warning first (no public CA issues certificates for a bare IP), then lands
# on the real site. ACME challenges are handled by Caddy before these routes, so the
# redirect does not interfere with certificate issuance.
:80 {
	redir https://{$TIA_DOMAIN:localhost}{uri} permanent
}

:443 {
	tls internal
	redir https://{$TIA_DOMAIN:localhost}{uri} permanent
}

{$TIA_DOMAIN:localhost} {
	encode gzip

	# SSE needs an unbuffered upstream; flush immediately.
	reverse_proxy backend:8000 {
		flush_interval -1
	}

	header {
		# The API sets its own security headers; these cover static assets too.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# While the backend restarts (a deploy takes it down for a few seconds) the proxy
	# has nothing to forward to. An empty error body is what some browsers offer as a
	# blank download; a sentence that says what is happening is not.
	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><meta charset="utf-8"><meta http-equiv="refresh" content="5"><title>Trader-IA</title><body style="font-family:sans-serif;background:#0b0e14;color:#e4e9f2;display:grid;place-items:center;height:100vh;margin:0"><p>Trader-IA is restarting &mdash; this page retries by itself in a few seconds.</p></body>` {err.status_code}
	}
}
