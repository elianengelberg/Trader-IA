+def _comparable(value: Any) -> Any:
+    """NaN is stored as NULL by SQLite; both mean "no value" when comparing."""
+    if isinstance(value, float) and math.isnan(value):
+        return None
+    if isinstance(value, list):
+        return [_comparable(v) for v in value]
+    return value
