 class BacktestRepository:
     def __init__(self, session: AsyncSession) -> None:
         self._session = session
 
     async def save(self, values: dict[str, Any]) -> None:
+        """Store a result. A row with the same ``run_id`` is replaced only by a result of
+        the same provenance and the same numbers — a re-run of the same engine over the
+        same bars. A row from another engine, from before the engine was recorded, or with
+        other numbers under the same provenance is never overwritten."""
+        existing = await self.get(values["run_id"])
+        stored = _provenance(existing.conditions) if existing is not None else None
+        if stored is not None and stored != _provenance(values.get("conditions")):
+            said = ", ".join(
+                f"{key}={value or 'unknown'}"
+                for key, value in zip(_BACKTEST_PROVENANCE, stored, strict=True)
+            )
+            raise ValueError(
+                f"backtest {values['run_id']} is already stored with another provenance "
+                f"({said}); refusing to replace it"
+            )
+        if existing is not None:
+            differ = [
+                key for key in _BACKTEST_NUMBERS
+                if key in values and _comparable(getattr(existing, key)) != _comparable(values[key])
+            ]
+            if differ:
+                raise ValueError(
+                    f"backtest {values['run_id']} is already stored with the same provenance and "
+                    f"other results ({', '.join(differ)}): something the provenance does not record "
+                    "changed (the environment, or a substituted part of the engine); refusing to "
+                    "replace it"
+                )
         await self._session.execute(_upsert(self._session, BacktestRow, values, ["run_id"]))
 
