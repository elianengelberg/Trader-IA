+#: What a stored result's conditions say about the engine, bars and instruments behind it.
+#: Results stored before these were recorded have none: "" is "unknown", not a value.
+_BACKTEST_PROVENANCE = (
+    "engine_version", "engine_fingerprint", "data_fingerprint", "universe_digest",
+)
+
+
+def _provenance(conditions: dict[str, Any] | None) -> tuple[str, ...]:
+    return tuple(str((conditions or {}).get(key) or "") for key in _BACKTEST_PROVENANCE)
+
+
+#: The numbers a stored result is made of. Under one ``run_id`` and one provenance they
+#: differ only if something the provenance does not record changed — the Python
+#: environment, or a part of the engine a caller substituted — and then neither run can
+#: claim the row: the store refuses instead of keeping whichever ran last.
+_BACKTEST_NUMBERS = ("bars", "trades", "total_return_pct", "max_drawdown_pct", "sharpe", "equity_curve")
+
+
+def _comparable(value: Any) -> Any:
+    """NaN is stored as NULL by SQLite; both mean "no value" when comparing."""
+    if isinstance(value, float) and math.isnan(value):
+        return None
+    if isinstance(value, list):
+        return [_comparable(v) for v in value]
+    return value
+
