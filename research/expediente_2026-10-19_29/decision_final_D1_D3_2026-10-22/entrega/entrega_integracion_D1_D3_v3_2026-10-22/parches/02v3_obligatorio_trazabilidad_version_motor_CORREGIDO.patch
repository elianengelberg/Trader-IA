+#: The engine's version, recorded on every result and part of its ``run_id``. Bump it with
+#: any change that can alter what a run produces from the same inputs.
+#: 1.1.0 — order hygiene D1-D3: fresh ids for retried exits and stops, the stop follows
+#: its level, no leg stuck behind an entry remainder. The first version recorded: results
+#: stored before it carry none, and their engine is unknown — not 1.0.0, not anything else.
+ENGINE_VERSION = "1.1.0"
+
+#: The sub-packages whose code decides what a run produces. Their source is hashed into
+#: the engine fingerprint, so a change nobody versioned still gives a different ``run_id``.
+_ENGINE_PACKAGES = (
+    "backtest", "core", "data", "domain", "economics", "execution", "quant", "regime", "risk",
+    "strategy",
+)
+
+
+@cache
+def engine_fingerprint() -> str:
+    """Hash of the engine's source: every ``.py`` file of ``_ENGINE_PACKAGES``, by path.
+
+    Conservative on purpose — an edited comment changes it too, and two results with
+    different fingerprints are never taken for the same run. Where the source cannot be
+    read (an install without ``.py`` files) it says ``unavailable`` rather than guess.
+    """
+    return _source_fingerprint(Path(__file__).resolve().parent.parent)
+
+
+def _source_fingerprint(root: Path) -> str:
+    digest = hashlib.sha256()
+    files = 0
+    try:
+        for package in _ENGINE_PACKAGES:
+            for path in sorted((root / package).rglob("*.py")):
+                digest.update(path.relative_to(root).as_posix().encode() + b"\0")
+                digest.update(path.read_bytes() + b"\0")
+                files += 1
+    except OSError:
+        return "unavailable"
+    return digest.hexdigest()[:32] if files else "unavailable"
+
+
+def data_fingerprint(bars: Sequence[Candle]) -> str:
+    """Hash of the bars a run consumed: one dataset name over different bars is two runs."""
+    digest = hashlib.sha256()
+    for c in bars:
+        digest.update(
+            f"{c.symbol}|{c.timeframe}|{c.open_time.isoformat()}|{c.close_time.isoformat()}|"
+            f"{c.open!r}|{c.high!r}|{c.low!r}|{c.close!r}|{c.volume!r}|{c.trade_count}\n".encode()
+        )
+    return digest.hexdigest()[:32]
+
 
