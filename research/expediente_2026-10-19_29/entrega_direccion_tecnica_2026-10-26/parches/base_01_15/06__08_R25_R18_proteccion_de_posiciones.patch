@@ -0,0 +1,159 @@
+"""R25: the protective stop through the Binance adapter, against a mock transport.
+
+Every position the live runtime opens is protected by an ``OrderType.STOP`` intent. The
+adapter had no mapping for it and refused each one locally, before any request — so a live
+session ran its positions without a stop, and no test noticed because the paper venue
+accepts stops natively.
+
+What these tests prove is the part that is ours: the request the adapter builds for a stop
+(the venue's STOP_LOSS: a stopPrice, no price, no timeInForce), that a malformed stop is
+refused before anything is sent, that the venue's refusals and lost answers surface as the
+errors the runtime acts on, and that a stop adopted from the venue is read as a stop. They
+do **not** prove that Binance accepts the request: the mock answers whatever it is told to.
+That is what ``scripts/validate_binance.py --stop --testnet`` is for, and the activation
+gate's venue validation fails until a testnet record says the venue accepted it.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime
+from typing import Any
+
+import httpx
+import pytest
+
+from tia.api.gate_probes import _venue_validation
+from tia.core.errors import ExecutionError, OrderRejectedError, ReconciliationError
+from tia.domain.enums import OrderState, OrderType, Side, TimeInForce
+from tia.domain.orders import OrderIntent
+from tia.live.gate import CheckName
+
+from .test_binance_live import ACK_RESPONSE, START, provider
+
+
+def stop_intent(*, stop_price: float | None = 48_000.0, limit_price: float | None = None,
+                signal_id: str = "protective:BTC-USD:run:7") -> OrderIntent:
+    return OrderIntent(
+        intent_id="int-stop",
+        client_order_id=OrderIntent.build_client_order_id(
+            signal_id=signal_id, symbol="BTC-USD", side=Side.SELL, quantity=0.01,
+            order_type=OrderType.STOP,
+        ),
+        signal_id=signal_id,
+        risk_decision_id="protective:BTC-USD",
+        symbol="BTC-USD",
+        side=Side.SELL,
+        quantity=0.01,
+        order_type=OrderType.STOP,
+        stop_price=stop_price,
+        limit_price=limit_price,
+        time_in_force=TimeInForce.GTC,
+        created_at=START,
+        reduce_only=True,
+    )
+
+
+def _params(request: httpx.Request) -> dict[str, str]:
+    return dict(httpx.QueryParams(request.url.query.decode()))
+
+
+async def test_a_stop_is_sent_as_stop_loss_with_a_stop_price_and_nothing_else() -> None:
+    seen: list[httpx.Request] = []
+    intent = stop_intent()
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        seen.append(request)
+        return httpx.Response(200, json={**ACK_RESPONSE, "type": "STOP_LOSS", "side": "SELL", "price": "0.00000000",
+                                         "stopPrice": "48000.00", "clientOrderId": intent.client_order_id})
+
+    order = await provider(handler, simulated=True).submit_order(intent)
+
+    assert len(seen) == 1 and seen[0].method == "POST" and seen[0].url.path == "/api/v3/order"
+    params = _params(seen[0])
+    assert params["type"] == "STOP_LOSS"
+    assert params["side"] == "SELL" and params["symbol"] == "BTCUSDT"
+    assert float(params["stopPrice"]) == 48_000.0 and float(params["quantity"]) == 0.01
+    assert params["newClientOrderId"] == intent.client_order_id
+    # STOP_LOSS takes neither: the venue answers "parameter sent when not required".
+    assert "timeInForce" not in params and "price" not in params
+    assert order.order_type is OrderType.STOP and order.state is OrderState.ACKNOWLEDGED
+    assert order.stop_price == 48_000.0
+
+
+@pytest.mark.parametrize("stop_price", [None, 0.0, -1.0])
+def test_a_stop_without_a_positive_level_is_not_an_intent(stop_price: float | None) -> None:
+    with pytest.raises(ValueError, match="stop"):
+        stop_intent(stop_price=stop_price)
+
+
+@pytest.mark.parametrize(("stop_price", "limit_price"), [(48_000.0, 47_900.0), (None, None)])
+async def test_a_malformed_stop_is_refused_before_any_request(stop_price: float | None, limit_price: float | None) -> None:
+    """The adapter's own check, under the domain model's: a stop with a limit price (which
+    the model allows) and one built without validation are refused before any request."""
+    calls: list[httpx.Request] = []
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        calls.append(request)
+        return httpx.Response(200, json=ACK_RESPONSE)
+
+    good = stop_intent()
+    malformed = good.model_copy(update={"stop_price": stop_price, "limit_price": limit_price})
+    with pytest.raises(ExecutionError, match="stop price"):
+        await provider(handler, simulated=True).submit_order(malformed)
+    assert calls == []
+
+
+@pytest.mark.parametrize(("code", "message"), [
+    (-1013, "Filter failure: PRICE_FILTER"),
+    (-2010, "Account has insufficient balance for requested action."),
+    (-1106, "Parameter 'timeInForce' sent when not required."),
+])
+async def test_a_stop_the_venue_refuses_is_an_error_not_an_order(code: int, message: str) -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        return httpx.Response(400, json={"code": code, "msg": message})
+
+    with pytest.raises(OrderRejectedError):
+        await provider(handler, simulated=True).submit_order(stop_intent())
+
+
+async def test_a_stop_whose_answer_is_lost_is_unknown_not_absent() -> None:
+    def handler(request: httpx.Request) -> httpx.Response:
+        raise httpx.ReadTimeout("no answer", request=request)
+
+    with pytest.raises(ReconciliationError, match="UNKNOWN"):
+        await provider(handler, simulated=True).submit_order(stop_intent())
+
+
+async def test_a_stop_adopted_from_the_venue_is_read_as_a_stop() -> None:
+    """An order no intent of this session describes (a restart, a resolved timeout) is
+    read by the venue's own type word; before, every one was read as MARKET."""
+    intent = stop_intent()
+
+    def handler(request: httpx.Request) -> httpx.Response:
+        assert request.method == "GET" and _params(request)["origClientOrderId"] == intent.client_order_id
+        return httpx.Response(200, json={**ACK_RESPONSE, "type": "STOP_LOSS", "side": "SELL", "price": "0.00000000",
+                                         "stopPrice": "48000.00", "clientOrderId": intent.client_order_id})
+
+    order = await provider(handler, simulated=True).resolve_unknown_order(
+        symbol="BTC-USD", client_order_id=intent.client_order_id
+    )
+    assert order is not None and order.order_type is OrderType.STOP and order.stop_price == 48_000.0
+
+
+def _record(**facts: Any) -> Any:
+    from tia.api.gate_probes import BinanceValidationRecord
+
+    return BinanceValidationRecord(
+        validator_version=2, generated_at=datetime.now(UTC), environment="testnet", symbol="BTCUSDT",
+        git_commit="abc", fingerprint="0" * 32,
+        facts={"duplicate_order_rejected": True, **facts},
+    )
+
+
+def test_live_activation_needs_a_venue_that_accepted_the_protective_stop() -> None:
+    """Binance live stays blocked until a testnet run accepted this adapter's stop."""
+    assert not _venue_validation(_record(), "").passed
+    assert not _venue_validation(_record(protective_stop_accepted=False), "").passed
+    assert _venue_validation(_record(protective_stop_accepted=True), "").passed
+    check = _venue_validation(_record(), "")
+    assert check.name is CheckName.VENUE_VALIDATION and "STOP_LOSS" in check.detail
