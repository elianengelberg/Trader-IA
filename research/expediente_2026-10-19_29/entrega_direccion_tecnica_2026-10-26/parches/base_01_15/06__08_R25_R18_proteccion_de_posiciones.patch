new file mode 100644
index 0000000..82513b6
--- /dev/null
+++ b/tests/integration/test_live_position_protection.py
@@ -0,0 +1,373 @@
+"""R25 and R18 in the live runtime: a held position is never left unprotected by choice.
+
+Policy, fixed before these tests were written:
+
+* A position is *protected* when the venue holds, for at least its whole size, a working
+  stop on the closing side, or a working close (a reduce-only order that is not a stop).
+* At every bar boundary — the moment a venue can match against a new bar — a held position
+  is protected. Tolerance zero: no bar, not one.
+* Inside a cycle the stop is cancelled to make way for a close; until the close is accepted
+  or the stop is back, the position is unprotected. That window is measured here in venue
+  calls and must close before the cycle ends (at most two calls: the cancel and a close
+  that does not work).
+* A stop the venue did not confirm — refused, rejected, or lost in a timeout it cannot
+  answer — is not a log line (R25): the position is counted unprotected once per spell, an
+  incident says why, entries are blocked, the session is halted for new orders and the stop
+  is asked for again every bar. A stop the venue confirms lifts the entry block; the halt
+  stays for an operator. A stop whose answer was lost is asked about before another is
+  sent: never two stops because an answer went missing.
+
+The venue here is the in-memory one of ``test_live_runtime``, which fills market orders on
+their acknowledgement as a real venue does, plus scripted failures and a record of what it
+holds after every call. Expected outcomes are stated per test before it runs.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import UTC, datetime, timedelta
+from typing import Any
+
+from tia.core.clock import SimulatedClock
+from tia.core.errors import ExecutionError, ReconciliationError
+from tia.domain.enums import OrderState, OrderType, Side
+from tia.domain.orders import Order, OrderIntent
+from tia.execution.state_machine import transition
+from tia.runtime.live import LiveRuntime
+from tia.runtime.scenarios import generate_series, get_scenario
+from tia.runtime.states import LiveState
+
+from .test_live_runtime import FakeExecution, FakeMarketData, _open_a_position, live_settings
+
+SYMBOL = "BTC-USD"
+
+
+@dataclass(frozen=True)
+class Event:
+    what: str
+    held: float
+    protected: bool | None  # None: nothing held
+    stops: int  # stops working at the venue
+
+
+class ProtectionVenue(FakeExecution):
+    """The in-memory venue with scripted stop and close failures and a record of whether
+    the position was protected after every call it answered and at every bar boundary."""
+
+    def __init__(self, **kwargs: Any) -> None:
+        super().__init__(**kwargs)
+        self.stop_script: list[str] = []  # per STOP submission: refuse | reject | timeout_absent | timeout_present | timeout_unknown
+        self.stop_default = ""  # applied once the script is used up ("" = accept)
+        self.close_script: list[str] = []  # per close: reject | raise | timeout_absent
+        self.reject_first_close_of_each_trip = False
+        self.resolver_down = False
+        self.events: list[Event] = []
+        self.looks: list[Event] = []
+        self.stop_submissions = 0
+        self.entry_submissions = 0
+        self._trip_close_rejected = False
+
+    # -- what the position has ---------------------------------------------------------
+    def held(self) -> float:
+        position = self.positions.get(SYMBOL)
+        return 0.0 if position is None else float(position.quantity)
+
+    def protected(self) -> bool | None:
+        held = self.held()
+        if abs(held) < 1e-12:
+            return None
+        against = Side.SELL if held > 0 else Side.BUY
+        for order in self.orders.values():
+            if order.state.is_terminal or order.symbol != SYMBOL or order.side is not against:
+                continue
+            if order.quantity - order.filled_quantity + 1e-12 < abs(held):
+                continue
+            if order.order_type is OrderType.STOP or order.reduce_only:
+                return True
+        return False
+
+    def _note(self, what: str) -> None:
+        self.events.append(Event(what, self.held(), self.protected(), len(self.working_stops())))
+
+    def look(self) -> None:
+        self.looks.append(Event("bar boundary", self.held(), self.protected(), len(self.working_stops())))
+
+    def working_stops(self) -> list[Order]:
+        return [o for o in self.orders.values() if o.order_type is OrderType.STOP and not o.state.is_terminal]
+
+    # -- the venue --------------------------------------------------------------------
+    def _dead(self, intent: OrderIntent, state: OrderState) -> Order:
+        now = self._clock_now()
+        self.submissions += 1
+        order = Order(
+            order_id=f"o-{self.submissions}", client_order_id=intent.client_order_id, intent_id=intent.intent_id,
+            signal_id=intent.signal_id, symbol=intent.symbol, side=intent.side, order_type=intent.order_type,
+            quantity=intent.quantity, stop_price=intent.stop_price, state=OrderState.ACKNOWLEDGED,
+            created_at=now, updated_at=now,
+        )
+        if state is OrderState.REJECTED:
+            transition(order, OrderState.REJECTED, at=now, reason="scripted venue rejection")
+        else:
+            transition(order, OrderState.CANCEL_REQUESTED, at=now)
+            transition(order, OrderState.CANCELLED, at=now, reason="scripted venue rejection")
+        order.reject_reason = "scripted venue rejection"
+        self.orders[intent.client_order_id] = order
+        return order
+
+    async def submit_order(self, intent: OrderIntent) -> Order:
+        is_stop = intent.order_type is OrderType.STOP
+        is_close = intent.reduce_only and not is_stop
+        try:
+            if is_stop and intent.client_order_id not in self.orders:
+                self.stop_submissions += 1
+                step = self.stop_script.pop(0) if self.stop_script else self.stop_default
+                if step == "refuse":
+                    raise ExecutionError("order type stop is not supported by this adapter")
+                if step == "reject":
+                    return self._dead(intent, OrderState.REJECTED)
+                if step == "timeout_absent":
+                    raise ReconciliationError("stop submission timed out (scripted)")
+                if step in ("timeout_present", "timeout_unknown"):
+                    await super().submit_order(intent)  # it did arrive and rests
+                    if step == "timeout_unknown":
+                        self.resolver_down = True
+                    raise ReconciliationError("stop submission timed out (scripted)")
+            if is_close and intent.client_order_id not in self.orders:
+                step = self.close_script.pop(0) if self.close_script else ""
+                if not step and self.reject_first_close_of_each_trip and not self._trip_close_rejected:
+                    self._trip_close_rejected = True
+                    step = "reject"
+                if step == "reject":
+                    return self._dead(intent, OrderState.CANCELLED)
+                if step == "raise":
+                    raise ExecutionError("close refused by the venue (scripted)")
+                if step == "timeout_absent":
+                    raise ReconciliationError("close submission timed out (scripted)")
+            if not intent.reduce_only and not is_stop:
+                self.entry_submissions += 1
+            order = await super().submit_order(intent)
+            if is_close and order.fills:
+                self._trip_close_rejected = False
+            return order
+        finally:
+            self._note(f"submit {intent.order_type.value}{' close' if is_close else ''}")
+
+    async def cancel_order(self, order_id: str) -> Order:
+        try:
+            return await super().cancel_order(order_id)
+        finally:
+            self._note("cancel")
+
+    async def resolve_unknown_order(self, *, symbol: str, client_order_id: str) -> Order | None:
+        if self.resolver_down:
+            raise ReconciliationError("the venue cannot say (scripted)")
+        return self.orders.get(client_order_id)
+
+
+def build(*, max_holding_bars: int = 0) -> tuple[LiveRuntime, ProtectionVenue, FakeMarketData, list[dict[str, Any]]]:
+    scenario = get_scenario("trend_up")
+    candles = generate_series(
+        scenario, symbol=SYMBOL, timeframe="1m",
+        start=datetime.now(UTC) - timedelta(minutes=scenario.total_bars + 5), seed=9,
+    )
+    clock = SimulatedClock(candles[149].close_time + timedelta(seconds=1))
+    market = FakeMarketData(candles, clock)
+    venue = ProtectionVenue(clock=clock)
+    written: list[dict[str, Any]] = []
+
+    def persist(kind: str, payload: dict[str, Any]) -> None:
+        if kind == "incident":
+            written.append(payload)
+
+    runtime = LiveRuntime(
+        live_settings(max_holding_bars=max_holding_bars), activation=None, market_data=market,
+        execution=venue, clock=clock, poll_interval_seconds=0.0, persist=persist,
+    )
+    return runtime, venue, market, written
+
+
+async def bar(runtime: LiveRuntime, venue: ProtectionVenue, market: FakeMarketData) -> None:
+    market.advance()
+    venue.look()  # the venue may match against this bar now: the position must be protected
+    await runtime._cycle_once()
+
+
+def unprotected_streak(events: list[Event]) -> int:
+    longest = streak = 0
+    for event in events:
+        streak = streak + 1 if event.protected is False else 0
+        longest = max(longest, streak)
+    return longest
+
+
+# ------------------------------------------------------------------------------- R18
+
+
+async def test_every_bar_boundary_finds_the_position_protected_while_closes_are_rejected() -> None:
+    """Expected: the first close of every round trip rejected, time stops every 3 bars,
+    200 bars; at least 3 closes rejected and 3 round trips completed; 0 bar boundaries with
+    a held position unprotected; inside a cycle at most 2 venue calls unprotected; never
+    two stops working at once; nothing counted unprotected."""
+    runtime, venue, market, _ = build(max_holding_bars=3)
+    venue.reject_first_close_of_each_trip = True
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        for _ in range(200):
+            await bar(runtime, venue, market)
+        assert runtime.counters["exits_rejected"] >= 3, runtime.counters["exits_rejected"]
+        assert runtime.counters["round_trips"] >= 3, runtime.counters["round_trips"]
+        held_looks = [look for look in venue.looks if look.protected is not None]
+        assert held_looks, "the scenario must hold positions across bars"
+        assert [look for look in held_looks if look.protected is False] == []
+        assert unprotected_streak(venue.events) <= 2, unprotected_streak(venue.events)
+        assert max(e.stops for e in venue.events) == 1
+        assert runtime.counters["unprotected_positions"] == 0
+    finally:
+        await runtime.stop()
+
+
+async def test_a_close_that_raises_or_times_out_puts_the_stop_back_in_the_same_call() -> None:
+    """Expected: after each failed close (refused with an exception; timed out and the
+    venue says it never arrived) exactly one stop is working before the market moves."""
+    runtime, venue, market, written = build()
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        await bar(runtime, venue, market)
+        for failure in ("raise", "timeout_absent"):
+            venue.close_script = [failure]
+            assert await runtime._close_position("time stop") is False
+            assert venue.held() != 0.0, "the position is still there"
+            assert len(venue.working_stops()) == 1, f"{failure}: the stop is back before the next bar"
+            assert venue.protected() is True
+        assert {"exit_submit_failed", "exit_not_accepted"} <= {i["kind"] for i in written}
+    finally:
+        await runtime.stop()
+
+
+async def test_an_entry_that_fills_at_once_is_protected_before_the_cycle_ends() -> None:
+    """Expected: the cycle that fills the entry also places its stop; the very next bar
+    boundary finds the position protected."""
+    runtime, venue, market, _ = build()
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        assert venue.held() != 0.0
+        assert venue.protected() is True
+        assert unprotected_streak(venue.events) <= 1  # the entry fill, then its stop
+    finally:
+        await runtime.stop()
+
+
+# ------------------------------------------------------------------------------- R25
+
+
+async def test_a_venue_that_refuses_every_stop_blocks_entries_halts_and_keeps_asking() -> None:
+    """Expected: unprotected counted once; an incident; entries blocked; HALT_NEW_ORDERS;
+    the stop asked for again on each of 5 bars; no entry sent meanwhile; the snapshot says
+    unprotected. Once the venue takes the stop: one working stop, entry block lifted, the
+    halt kept until an operator resumes."""
+    runtime, venue, market, written = build()
+    venue.stop_default = "refuse"
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        assert venue.protected() is False
+        assert runtime.counters["unprotected_positions"] == 1
+        assert "position_unprotected" in runtime.entry_blocks
+        assert runtime.machine.state is LiveState.HALT_NEW_ORDERS
+        assert runtime.last_error.startswith("position unprotected")
+        assert runtime.snapshot()["position"]["protected"] is False
+        assert "protective_stop_failed" in {i["kind"] for i in written}
+        asked, entries = venue.stop_submissions, venue.entry_submissions
+        for _ in range(5):
+            await bar(runtime, venue, market)
+        assert venue.stop_submissions == asked + 5, "asked for again on every bar"
+        assert venue.entry_submissions == entries, "no entry while a position is unprotected"
+        assert runtime.counters["unprotected_positions"] == 1, "one spell, counted once"
+        assert runtime.counters["protective_stop_failures"] == venue.stop_submissions
+
+        venue.stop_default = ""
+        await bar(runtime, venue, market)
+        assert len(venue.working_stops()) == 1 and venue.protected() is True
+        assert "position_unprotected" not in runtime.entry_blocks
+        assert runtime.last_error == ""
+        assert runtime.machine.state is LiveState.HALT_NEW_ORDERS, "re-protection does not resume trading"
+        runtime.resume(actor="test operator")
+        assert runtime.machine.state is LiveState.RUNNING
+    finally:
+        await runtime.stop()
+
+
+async def test_a_stop_rejected_as_an_order_is_handled_like_a_refused_one() -> None:
+    """Expected: a REJECTED stop order is not a stop: same block, halt and count."""
+    runtime, venue, market, _ = build()
+    venue.stop_script = ["reject"]
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        assert runtime.counters["unprotected_positions"] == 1
+        assert runtime.machine.state is LiveState.HALT_NEW_ORDERS
+        await bar(runtime, venue, market)
+        assert len(venue.working_stops()) == 1 and "position_unprotected" not in runtime.entry_blocks
+    finally:
+        await runtime.stop()
+
+
+async def test_a_stop_whose_answer_was_lost_but_rests_at_the_venue_is_adopted_not_duplicated() -> None:
+    """Expected: the timed-out stop is found resting and adopted in the same call: one
+    stop sent, one working, nothing halted or counted unprotected; later bars move it like
+    any other (the trailing stop), never with two working at once."""
+    runtime, venue, market, _ = build()
+    venue.stop_script = ["timeout_present"]
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        assert venue.stop_submissions == 1
+        assert len(venue.working_stops()) == 1 and venue.protected() is True
+        assert runtime.counters["unknown_order_states"] >= 1
+        assert runtime.counters["unprotected_positions"] == 0
+        assert runtime.machine.state is LiveState.RUNNING
+        for _ in range(3):
+            await bar(runtime, venue, market)
+        assert max(e.stops for e in venue.events) == 1 and venue.protected() is True
+    finally:
+        await runtime.stop()
+
+
+async def test_a_stop_the_venue_says_never_arrived_is_sent_again_on_the_next_bar() -> None:
+    """Expected: unprotected spell counted, halted; the next bar sends a new stop."""
+    runtime, venue, market, _ = build()
+    venue.stop_script = ["timeout_absent"]
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        assert runtime.counters["unprotected_positions"] == 1
+        await bar(runtime, venue, market)
+        assert venue.stop_submissions == 2 and len(venue.working_stops()) == 1
+    finally:
+        await runtime.stop()
+
+
+async def test_no_second_stop_while_the_venue_cannot_say_whether_the_first_arrived() -> None:
+    """Expected: while the venue cannot answer, no stop is sent (3 bars), entries stay
+    blocked and the session halted; when it answers, the resting stop is adopted (and moved,
+    if the exit rules moved its level meanwhile), never two working at once."""
+    runtime, venue, market, _ = build()
+    venue.stop_script = ["timeout_unknown"]
+    await runtime.start()
+    try:
+        await _open_a_position(runtime, venue, market)
+        for _ in range(3):
+            await bar(runtime, venue, market)
+        assert venue.stop_submissions == 1, "never two stops because an answer went missing"
+        assert "position_unprotected" in runtime.entry_blocks
+        assert runtime.machine.state is LiveState.HALT_NEW_ORDERS
+        venue.resolver_down = False
+        await bar(runtime, venue, market)
+        assert len(venue.working_stops()) == 1 and venue.protected() is True
+        assert max(e.stops for e in venue.events) == 1
+        assert "position_unprotected" not in runtime.entry_blocks
+    finally:
+        await runtime.stop()
