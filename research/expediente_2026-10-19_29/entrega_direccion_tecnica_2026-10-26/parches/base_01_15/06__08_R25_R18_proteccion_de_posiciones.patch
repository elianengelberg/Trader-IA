+async def validate_stop(
+    client: httpx.AsyncClient, signer: BinanceSigner, results: Results, symbol: str
+) -> None:
+    """Place one protective stop **through the adapter** on the testnet, read it, cancel it.
+
+    The request is the one the live runtime sends for every protective stop (an
+    ``OrderType.STOP`` intent, which the adapter maps to STOP_LOSS), not one written by
+    hand here: what is validated is this repository's request, not the documentation. A
+    SELL stop half the market below, for a small size the testnet account holds: it rests
+    and never triggers. Recorded as ``protective_stop_accepted``; the activation gate's
+    venue validation fails without it (R25).
+    """
+    section("Protective stop through the adapter (testnet)")
+    results.facts["protective_stop_accepted"] = False
+    try:
+        book = (
+            await client.get("/api/v3/ticker/bookTicker", params={"symbol": symbol})
+        ).json()
+        level = round(float(book["bidPrice"]) * 0.5, 2)
+    except (httpx.HTTPError, KeyError, ValueError) as exc:
+        results.bad("protective stop", f"could not read the book: {exc}")
+        return
+    adapter = BinanceExecutionProvider(
+        signer=signer, clock=SystemClock(), simulated=True, base_url=str(client.base_url)
+    )
+    ours = BinanceExecutionProvider.from_venue_symbol(symbol)
+    stamp = int(datetime.now(UTC).timestamp())
+    intent = OrderIntent(
+        intent_id=f"validate-stop-{stamp}",
+        client_order_id=OrderIntent.build_client_order_id(
+            signal_id=f"validate-stop-{stamp}", symbol=ours, side=Side.SELL,
+            quantity=0.001, order_type=OrderType.STOP,
+        ),
+        signal_id=f"validate-stop-{stamp}",
+        risk_decision_id="validate-stop",
+        symbol=ours,
+        side=Side.SELL,
+        quantity=0.001,
+        order_type=OrderType.STOP,
+        stop_price=level,
+        time_in_force=TimeInForce.GTC,
+        created_at=datetime.now(UTC),
+        reduce_only=True,
+    )
+    try:
+        try:
+            order = await adapter.submit_order(intent)
+        except Exception as exc:
+            results.bad("protective stop", f"the venue refused the adapter's stop: {str(exc)[:300]}")
+            return
+        if order.state.is_terminal:
+            results.bad("protective stop", f"accepted then {order.state.value}: {order.reject_reason}")
