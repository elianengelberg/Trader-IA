index 0000000..7037b5d
--- /dev/null
+++ b/tests/unit/test_backtest_protection_window.py
@@ -0,0 +1,207 @@
+"""R18 in the backtest: no bar is matched with a held position the engine left uncovered.
+
+The venue matches resting orders at the start of every bar. A held position must meet that
+moment covered: a working stop on the closing side, or a working close. Tolerance zero —
+the order-hygiene tests allow up to eight bars and the version guard one, and a one-bar
+allowance is exactly where this window hid: a close the venue rejected left the stop
+cancelled until the next sync, which runs *after* the next bar is matched.
+
+The only uncovered bar these tests accept is one the venue chose: the engine sent a stop
+on the previous bar and the venue rejected it (a random rejection rate rejects stops too).
+Every other uncovered bar fails, with the bar and what was sent before it.
+
+Expected outcomes, fixed before running: 0 engine-caused uncovered bars in every scenario,
+and each scenario must actually reject closes (or stops) for the check to mean anything.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import ClassVar
+
+import pytest
+
+import tia.backtest.engine as engine_module
+from tia.backtest import BacktestConfig, BacktestEngine
+from tia.core.config import ExecutionSimConfig
+from tia.data.providers.csv_replay import CsvReplayProvider
+from tia.domain.enums import OrderState, OrderType, Side
+from tia.domain.instruments import DEFAULT_UNIVERSE
+from tia.domain.market import Candle
+from tia.execution.paper import PaperExecutionProvider
+from tia.execution.state_machine import transition
+from tia.strategy import library
+from tia.strategy.library import TrendFollowingStrategy
+
+FIXTURES = Path(__file__).resolve().parents[2] / "data" / "fixtures"
+SERIES: list[Candle] = asyncio.run(CsvReplayProvider(FIXTURES).get_candles("BTC-USD", "1h", limit=700))
+
+
+@dataclass
+class Sent:
+    bar: int
+    order_type: OrderType
+    reduce_only: bool
+    rejected: bool
+
+
+@dataclass
+class Look:
+    bar: int
+    held: float
+    covered: bool
+
+
+@dataclass
+class Record:
+    sent: list[Sent] = field(default_factory=list)
+    looks: list[Look] = field(default_factory=list)
+    closes_rejected: int = 0
+    stops_rejected: int = 0
+
+
+def _is_close(order: object) -> bool:
+    return bool(getattr(order, "reduce_only", False)) and getattr(order, "order_type", None) is not OrderType.STOP
+
+
+class _Venue(PaperExecutionProvider):
+    """The paper venue, recording; per scenario it rejects closes (the first of each
+    position, or the first two) or lets them fill only at once."""
+
+    last: ClassVar[_Venue | None] = None
+    closes_to_reject: ClassVar[int] = 0
+    closes_are_ioc: ClassVar[bool] = False
+
+    def __init__(self, *args: object, **kwargs: object) -> None:
+        super().__init__(*args, **kwargs)  # type: ignore[arg-type]
+        _Venue.last = self
+        self.bar = -1
+        self.record = Record()
+        self._rejected_this_position = 0
+
+    def _held(self, symbol: str) -> float:
+        position = self.portfolio.positions.get(symbol)
+        return 0.0 if position is None or position.is_flat else float(position.quantity)
+
+    def _should_reject(self, order):  # type: ignore[no-untyped-def]
+        if _is_close(order) and self._rejected_this_position < self.closes_to_reject:
+            self._rejected_this_position += 1
+            self.record.closes_rejected += 1
+            return True
+        rejected = super()._should_reject(order)
+        if rejected and order.order_type is OrderType.STOP:
+            self.record.stops_rejected += 1
+        return rejected
+
+    async def submit_order(self, intent):  # type: ignore[no-untyped-def]
+        order = await super().submit_order(intent)
+        self.record.sent.append(Sent(self.bar, intent.order_type, bool(intent.reduce_only),
+                                     order.state.is_terminal and not order.fills))
+        return order
+
+    def _try_fill(self, order, candle):  # type: ignore[no-untyped-def]
+        before = self._held(order.symbol)
+        fill = super()._try_fill(order, candle)
+        if fill is not None and before == 0.0 and self._held(order.symbol) != 0.0:
+            self._rejected_this_position = 0  # a new position
+        if self.closes_are_ioc and _is_close(order) and not order.state.is_terminal:
+            transition(order, OrderState.EXPIRED, at=candle.close_time, reason="immediate-or-cancel")
+        return fill
+
+    def on_bar(self, candle):  # type: ignore[no-untyped-def]
+        self.bar += 1
+        held = self._held(candle.symbol)
+        covered = False
+        if held:
+            against = Side.SELL if held > 0 else Side.BUY
+            for order in asyncio.run(self.get_orders(open_only=True)):
+                if order.symbol != candle.symbol or order.side is not against:
+                    continue
+                if order.quantity - order.filled_quantity + 1e-12 < abs(held):
+                    continue
+                if order.order_type is OrderType.STOP or order.reduce_only:
+                    covered = True
+        self.record.looks.append(Look(self.bar, held, covered))
+        return super().on_bar(candle)
+
+
+class _PatientTrendFollowing(TrendFollowingStrategy):
+    """Keeps positions open long enough for the signal to reverse (as in the hygiene tests)."""
+
+    def __init__(self) -> None:
+        super().__init__(adx_threshold=10.0, atr_stop_multiple=12.0)
+
+
+def _run(monkeypatch: pytest.MonkeyPatch, *, closes_to_reject: int = 1, closes_are_ioc: bool = False,
+         reject: float = 0.0, partial: float = 0.0, strategies: tuple[str, ...] | None = None,
+         **config: object) -> Record:
+    monkeypatch.setattr(engine_module, "PaperExecutionProvider", _Venue)
+    monkeypatch.setattr(_Venue, "closes_to_reject", closes_to_reject)
+    monkeypatch.setattr(_Venue, "closes_are_ioc", closes_are_ioc)
+    monkeypatch.setattr(_Venue, "last", None)
+    BacktestEngine(
+        BacktestConfig(dataset="fixtures", timeframe="1h", warmup_bars=120,
+                       execution=ExecutionSimConfig(reject_probability=reject, partial_fill_probability=partial),
+                       **config),
+        DEFAULT_UNIVERSE,
+        strategies=strategies,
+    ).run(SERIES)
+    venue = _Venue.last
+    assert venue is not None and len(venue.record.looks) == len(SERIES), "the engine did not run on the recording venue"
+    return venue.record
+
+
+def uncovered_by_the_engine(record: Record) -> list[str]:
+    """Bars matched with a held position and nothing covering it, except where the venue
+    rejected the stop the engine sent on the bar before."""
+    found = []
+    for look in record.looks:
+        if not look.held or look.covered:
+            continue
+        before = [s for s in record.sent if s.bar == look.bar - 1]
+        last_stop = next((s for s in reversed(before) if s.order_type is OrderType.STOP), None)
+        if last_stop is not None and last_stop.rejected:
+            continue  # the venue's choice, not the engine's
+        sent = [f"{s.order_type.value}{'/close' if s.reduce_only else ''}{' REJECTED' if s.rejected else ''}" for s in before]
+        found.append(f"bar {look.bar}: {look.held} held uncovered; sent on bar {look.bar - 1}: {sent}")
+    return found
+
+
+def test_a_rejected_time_stop_close_leaves_no_bar_uncovered(monkeypatch: pytest.MonkeyPatch) -> None:
+    record = _run(monkeypatch, closes_to_reject=1, max_holding_bars=6)
+    assert record.closes_rejected >= 5, record.closes_rejected
+    assert not uncovered_by_the_engine(record), uncovered_by_the_engine(record)[:3]
+
+
+def test_a_rejected_reversal_close_leaves_no_bar_uncovered(monkeypatch: pytest.MonkeyPatch) -> None:
+    """The reversal path: the close is asked for in the decision step and the bar ends
+    right after it — before 1.2.0 with the stop cancelled and nothing working."""
+    monkeypatch.setitem(library.STRATEGY_REGISTRY, "trend_following", _PatientTrendFollowing)
+    record = _run(monkeypatch, closes_to_reject=1, strategies=("trend_following",), use_target=False,
+                  trail_atr_multiple=50.0, breakeven_after_r=50.0)
+    assert record.closes_rejected >= 3, record.closes_rejected  # the fixture reverses three legs
+    assert not uncovered_by_the_engine(record), uncovered_by_the_engine(record)[:3]
+
+
+def test_closes_rejected_twice_with_random_rejections_and_partials(monkeypatch: pytest.MonkeyPatch) -> None:
+    record = _run(monkeypatch, closes_to_reject=2, reject=0.3, partial=0.6, entry_order_type="limit",
+                  max_holding_bars=6)
+    assert record.closes_rejected >= 5 and record.stops_rejected >= 1, (record.closes_rejected, record.stops_rejected)
+    assert not uncovered_by_the_engine(record), uncovered_by_the_engine(record)[:3]
+
+
+def test_immediate_or_cancel_closes_leave_no_bar_uncovered(monkeypatch: pytest.MonkeyPatch) -> None:
+    record = _run(monkeypatch, closes_to_reject=0, closes_are_ioc=True, partial=0.9, max_holding_bars=6)
+    assert any(s.reduce_only for s in record.sent)
+    assert not uncovered_by_the_engine(record), uncovered_by_the_engine(record)[:3]
+
+
+def test_the_check_catches_an_uncovered_bar_and_excuses_only_a_rejected_stop() -> None:
+    """Without this a check that can never fail would pass every engine."""
+    caught = Record(sent=[Sent(4, OrderType.MARKET, True, True)], looks=[Look(5, 1.0, False)])
+    assert uncovered_by_the_engine(caught)
+    excused = Record(sent=[Sent(4, OrderType.STOP, False, True)], looks=[Look(5, 1.0, False)])
+    assert not uncovered_by_the_engine(excused)
+    assert not uncovered_by_the_engine(Record(looks=[Look(5, 1.0, True), Look(6, 0.0, False)]))
