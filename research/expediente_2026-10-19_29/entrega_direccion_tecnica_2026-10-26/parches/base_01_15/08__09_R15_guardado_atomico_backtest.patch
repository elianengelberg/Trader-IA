+def _insert_if_absent(session: AsyncSession, table: Any, values: dict[str, Any], key: str):
+    """Insert the row unless its key exists, returning the key only when it inserted.
+    The unique index is the arbiter: a concurrent insert of the same key waits for the
+    other transaction and then does nothing, so exactly one writer claims the row."""
+    dialect = session.bind.dialect.name if session.bind is not None else "sqlite"
+    statement = pg_insert(table) if dialect == "postgresql" else sqlite_insert(table)
+    return (
+        statement.values(**values)
+        .on_conflict_do_nothing(index_elements=[key])
+        .returning(getattr(table, key))
+    )
+
