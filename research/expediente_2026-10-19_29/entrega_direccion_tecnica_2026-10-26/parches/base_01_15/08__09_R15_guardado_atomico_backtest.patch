diff --git a/tests/integration/test_backtest_store_concurrency.py b/tests/integration/test_backtest_store_concurrency.py
new file mode 100644
index 0000000..f8ee486
--- /dev/null
+++ b/tests/integration/test_backtest_store_concurrency.py
@@ -0,0 +1,188 @@
+"""R15: one ``run_id``, several writers — exactly one result is stored and nobody else is told
+it was.
+
+``save()`` used to read the row and then upsert it. Two writers with different results
+both read "nothing there" and both upserted: each was told it stored, and the row held
+whichever committed last. Against PostgreSQL 16 that happened in every attempt of the
+review harness. The store now claims the row with an insert the unique index arbitrates,
+and compares under a row lock when it lost the claim.
+
+The SQLite tests pin the outcomes; the PostgreSQL ones (only with ``TIA_TEST_POSTGRESQL_URL``
+naming a disposable server, as the store's other PostgreSQL tests) race real connections.
+Expected, fixed before running: no writer whose content is not the stored row is told it
+stored; identical writers are all accepted; a writer whose transaction fails is not.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+import uuid
+from pathlib import Path
+from typing import Any
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.engine import make_url
+
+from tests.integration.test_backtest_provenance import _row, _run
+from tia.persistence import (
+    BacktestProvenanceConflictError,
+    BacktestRepository,
+    BacktestResultConflictError,
+    Database,
+    SaveOutcome,
+)
+
+ROW = _row(_run())
+OTHER_NUMBERS = {**ROW, "trades": ROW["trades"] + 1, "total_return_pct": ROW["total_return_pct"] + 1.0}
+OTHER_ENGINE = {**ROW, "conditions": {**ROW["conditions"], "engine_version": "9.9.9"}}
+
+
+async def _save(db: Database, row: dict[str, Any]) -> SaveOutcome:
+    async with db.session() as session:
+        return await BacktestRepository(session).save(row)
+
+
+async def _stored(db: Database) -> list[Any]:
+    async with db.session() as session:
+        return await BacktestRepository(session).list_recent()
+
+
+def _key(row: Any) -> tuple[Any, ...]:
+    get = row.get if isinstance(row, dict) else lambda k: getattr(row, k)
+    return (get("conditions").get("engine_version"), get("trades"), round(get("total_return_pct"), 9))
+
+
+async def test_each_save_says_what_it_did(tmp_path: Path) -> None:
+    db = Database(f"sqlite+aiosqlite:///{tmp_path / 'store.db'}")
+    await db.create_schema()
+    try:
+        assert await _save(db, ROW) is SaveOutcome.CREATED
+        assert await _save(db, dict(ROW)) is SaveOutcome.REPEATED
+        with pytest.raises(BacktestResultConflictError):
+            await _save(db, OTHER_NUMBERS)
+        with pytest.raises(BacktestProvenanceConflictError):
+            await _save(db, OTHER_ENGINE)
+        assert [_key(r) for r in await _stored(db)] == [_key(ROW)]
+    finally:
+        await db.close()
+
+
+SERVER = os.environ.get("TIA_TEST_POSTGRESQL_URL")
+postgresql = pytest.mark.skipif(not SERVER, reason="TIA_TEST_POSTGRESQL_URL names no disposable PostgreSQL server")
+
+
+@pytest.fixture
+async def pg():  # type: ignore[no-untyped-def]
+    admin = Database(SERVER or "")
+    name = "tia_race_" + uuid.uuid4().hex[:12]
+    async with admin.engine.connect() as conn:
+        await (await conn.execution_options(isolation_level="AUTOCOMMIT")).execute(text(f'CREATE DATABASE "{name}"'))
+    db = Database(make_url(SERVER or "").set(database=name).render_as_string(hide_password=False))
+    await db.create_schema()
+    try:
+        yield db
+    finally:
+        await db.close()
+        async with admin.engine.connect() as conn:
+            await (await conn.execution_options(isolation_level="AUTOCOMMIT")).execute(text(f'DROP DATABASE "{name}"'))
+        await admin.close()
+
+
+async def _writer(db: Database, row: dict[str, Any], go: asyncio.Event, delay: float) -> str:
+    try:
+        async with db.session() as session:
+            await go.wait()
+            await asyncio.sleep(delay)
+            await BacktestRepository(session).save(row)
+        return "stored"
+    except ValueError:
+        return "refused"
+
+
+async def _race(db: Database, rows: list[dict[str, Any]], delays: list[float]) -> tuple[list[str], list[Any]]:
+    async with db.engine.begin() as conn:
+        await conn.execute(text("TRUNCATE backtests"))
+    go = asyncio.Event()
+    tasks = [asyncio.create_task(_writer(db, r, go, d)) for r, d in zip(rows, delays, strict=True)]
+    await asyncio.sleep(0.02)
+    go.set()
+    return await asyncio.gather(*tasks), await _stored(db)
+
+
+@postgresql
+@pytest.mark.parametrize("other", [OTHER_NUMBERS, OTHER_ENGINE], ids=["other_numbers", "other_engine"])
+async def test_racing_writers_with_different_results_store_one_and_refuse_the_other(pg: Database, other: dict[str, Any]) -> None:
+    for attempt in range(12):
+        delays = [0.0, (0.0, 0.001, 0.005, 0.02)[attempt % 4]]
+        rows = [ROW, other] if attempt % 2 == 0 else [other, ROW]
+        said, stored = await _race(pg, rows, delays)
+        assert len(stored) == 1
+        told_stored = [r for r, s in zip(rows, said, strict=True) if s == "stored"]
+        assert len(told_stored) == 1, (attempt, said)
+        assert _key(told_stored[0]) == _key(stored[0]), "the writer told it stored is the one stored"
+
+
+@postgresql
+async def test_racing_identical_writers_are_all_accepted(pg: Database) -> None:
+    said, stored = await _race(pg, [ROW, dict(ROW), dict(ROW)], [0.0, 0.0, 0.002])
+    assert said == ["stored"] * 3 and len(stored) == 1
+
+
+@postgresql
+async def test_a_writer_whose_transaction_fails_is_not_the_one_stored(pg: Database) -> None:
+    """The first writer claims the row and then fails before its commit: its claim goes
+    with its transaction, and the second writer — waiting on the index — stores."""
+    async with pg.engine.begin() as conn:
+        await conn.execute(text("TRUNCATE backtests"))
+    go = asyncio.Event()
+
+    async def fails() -> str:
+        try:
+            async with pg.session() as session:
+                await go.wait()
+                await BacktestRepository(session).save(ROW)
+                await asyncio.sleep(0.05)
+                raise RuntimeError("the writer fails before its commit")
+        except RuntimeError:
+            return "failed"
+
+    tasks = [asyncio.create_task(fails()), asyncio.create_task(_writer(pg, OTHER_NUMBERS, go, 0.01))]
+    await asyncio.sleep(0.02)
+    go.set()
+    assert await asyncio.gather(*tasks) == ["failed", "stored"]
+    assert [_key(r) for r in await _stored(pg)] == [_key(OTHER_NUMBERS)]
+
+
+@postgresql
+async def test_a_writer_that_times_out_waiting_is_not_told_it_stored(pg: Database) -> None:
+    async with pg.engine.begin() as conn:
+        await conn.execute(text("TRUNCATE backtests"))
+    go = asyncio.Event()
+
+    async def holds() -> str:
+        async with pg.session() as session:
+            await go.wait()
+            await BacktestRepository(session).save(ROW)
+            await asyncio.sleep(1.0)
+        return "stored"
+
+    async def waits() -> str:
+        try:
+            async with pg.session() as session:
+                await go.wait()
+                await asyncio.sleep(0.1)
+                await session.execute(text("SET LOCAL lock_timeout = '200ms'"))
+                await BacktestRepository(session).save(OTHER_NUMBERS)
+            return "stored"
+        except ValueError:
+            return "refused"
+        except Exception:  # the lock timeout, whatever the driver calls it
+            return "error"
+
+    tasks = [asyncio.create_task(holds()), asyncio.create_task(waits())]
+    await asyncio.sleep(0.02)
+    go.set()
+    assert await asyncio.gather(*tasks) == ["stored", "error"]
+    assert [_key(r) for r in await _stored(pg)] == [_key(ROW)]
