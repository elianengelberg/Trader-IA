diff --git a/scripts/ci_provenance.py b/scripts/ci_provenance.py
new file mode 100644
index 0000000..71909bd
--- /dev/null
+++ b/scripts/ci_provenance.py
@@ -0,0 +1,161 @@
+"""pytest plugin: what this test run was, recorded by the interpreter that ran it.
+
+Loaded only by CI (``python -m pytest tests -p scripts.ci_provenance ...``). It writes
+``ci-evidence/session.json`` and stamps the JUnit report, so the gate (``scripts/ci_gate.py``)
+judges a run by facts from inside it instead of by what another interpreter sees later:
+
+* the run nonce (``CI_RUN_NONCE``, set by the workflow), also written into the JUnit report
+  as a testsuite property — a report or a session file from another run does not match;
+* the interpreter (executable, version) and every installed distribution, from
+  ``importlib.metadata`` of *this* process — not a ``pip freeze`` run elsewhere;
+* the engine as imported here: its ``ENGINE_VERSION`` and the file it was imported from,
+  with that file's hash — a module substituted on the path shows up as another file;
+* the working tree's content id when the run started, so files changed afterwards show;
+* how the suite was selected (paths, ``-k``, ``-m``, deselections, ``--lf``) and the
+  outcome of every test, under the name the JUnit report gives it.
+
+It changes no test and no outcome.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.metadata
+import json
+import os
+import platform
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+from typing import Any
+
+import pytest
+from _pytest.junitxml import mangle_test_address
+
+EVIDENCE = Path(os.environ.get("CI_EVIDENCE_DIR", "ci-evidence"))
+_STATE: dict[str, Any] = {"outcomes": {}, "deselected": 0}
+
+
+def working_tree_id(root: Path) -> str | None:
+    """The git tree id of the working copy as it is on disk (every tracked file, even one a
+    ``.gitignore`` pattern matches, and every untracked file that is not ignored, minus the
+    evidence directory), computed in a throwaway index seeded from ``HEAD``: the
+    repository's own index is not touched."""
+    git = shutil.which("git")
+    if git is None:
+        return None
+    evidence = (root / EVIDENCE).resolve()
+    inside = evidence.is_relative_to(root.resolve())
+    exclude = [f":(exclude){evidence.relative_to(root.resolve()).as_posix()}"] if inside else []
+    with tempfile.TemporaryDirectory() as scratch:
+        env = dict(os.environ, GIT_INDEX_FILE=str(Path(scratch) / "index"))
+        run = {"cwd": root, "env": env, "capture_output": True, "text": True, "check": False}
+        seeded = subprocess.run([git, "read-tree", "HEAD"], **run)  # noqa: S603 - fixed argv
+        if seeded.returncode != 0:
+            return None
+        added = subprocess.run([git, "add", "-A", "--", ".", *exclude], **run)  # noqa: S603 - fixed argv
+        if added.returncode != 0:
+            return None
+        tree = subprocess.run([git, "write-tree"], **run)  # noqa: S603 - fixed argv
+        return tree.stdout.strip() or None
+
+
+def _sha256(path: Path) -> str | None:
+    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None
+
+
+def _distributions() -> list[str]:
+    found = {}
+    for dist in importlib.metadata.distributions():
+        name = (dist.metadata.get("Name") or "").strip()
+        if name:
+            found[name.lower().replace("_", "-")] = dist.version
+    return sorted(f"{name}=={version}" for name, version in found.items())
+
+
+def _engine(root: Path) -> dict[str, Any]:
+    try:
+        import tia.backtest.engine as engine
+    except Exception as exc:  # recorded, judged by the gate
+        return {"error": f"{type(exc).__name__}: {exc}"[:300]}
+    path = Path(engine.__file__).resolve()
+    try:
+        relative = path.relative_to(root.resolve()).as_posix()
+    except ValueError:
+        relative = None
+    return {
+        "version": getattr(engine, "ENGINE_VERSION", None),
+        "file": str(path),
+        "file_in_checkout": relative,
+        "file_sha256": _sha256(path),
+    }
+
+
+def pytest_configure(config: pytest.Config) -> None:
+    root = Path(config.rootpath)
+    option = config.option
+    distributions = _distributions()
+    _STATE.update({
+        "nonce": os.environ.get("CI_RUN_NONCE"),
+        "started_at": time.time(),
+        "rootdir": str(root),
+        "python": {"executable": sys.executable, "version": platform.python_version(),
+                   "implementation": platform.python_implementation(), "prefix": sys.prefix},
+        "distributions": distributions,
+        "distributions_sha256": hashlib.sha256("\n".join(distributions).encode()).hexdigest(),
+        "working_tree_at_start": working_tree_id(root),
+        "selection": {
+            "args": list(config.args),
+            "keyword": getattr(option, "keyword", "") or "",
+            "markexpr": getattr(option, "markexpr", "") or "",
+            "deselect": list(getattr(option, "deselect", None) or []),
+            "ignore": list(getattr(option, "ignore", None) or []) + list(getattr(option, "ignore_glob", None) or []),
+            "lf": bool(getattr(option, "lf", False)),
+            "ff": bool(getattr(option, "failedfirst", False)),
+            "maxfail": int(getattr(option, "maxfail", 0) or 0),
+        },
+    })
+
+
+def pytest_deselected(items: list[pytest.Item]) -> None:
+    _STATE["deselected"] += len(items)
+
+
+def pytest_collection_finish(session: pytest.Session) -> None:
+    _STATE["collected"] = len(session.items)
+    _STATE["engine"] = _engine(Path(session.config.rootpath))
+
+
+def pytest_runtest_logreport(report: pytest.TestReport) -> None:
+    names = mangle_test_address(report.nodeid)
+    key = f"{'.'.join(names[:-1])}::{names[-1]}"
+    outcomes = _STATE["outcomes"]
+    if report.when == "setup":
+        if report.skipped:
+            outcomes[key] = "xfailed" if hasattr(report, "wasxfail") else "skipped"
+        elif report.failed:
+            outcomes[key] = "error"
+    elif report.when == "call":
+        if hasattr(report, "wasxfail"):
+            outcomes[key] = "xfailed" if report.skipped else "xpassed"
+        else:
+            outcomes[key] = report.outcome  # passed | failed | skipped
+    elif report.when == "teardown" and report.failed:
+        outcomes[key] = "error"
+
+
+@pytest.fixture(scope="session", autouse=True)
+def _ci_provenance_stamp(record_testsuite_property: Any) -> None:
+    """The run's nonce and interpreter, written into the JUnit report itself."""
+    record_testsuite_property("ci_run_nonce", _STATE.get("nonce") or "")
+    record_testsuite_property("ci_python", _STATE["python"]["version"])
+    record_testsuite_property("ci_distributions_sha256", _STATE["distributions_sha256"])
+
+
+def pytest_sessionfinish(session: pytest.Session, exitstatus: int) -> None:  # noqa: ARG001 - the hook's signature
+    EVIDENCE.mkdir(parents=True, exist_ok=True)
+    record = {**_STATE, "finished_at": time.time(), "exitstatus": int(exitstatus)}
+    (EVIDENCE / "session.json").write_text(json.dumps(record, indent=1, sort_keys=True) + "\n")
