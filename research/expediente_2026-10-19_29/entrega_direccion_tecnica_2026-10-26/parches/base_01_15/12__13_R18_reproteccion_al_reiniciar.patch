+    async def _protect_restored_position(self) -> None:
+        """Put a restored position under its stop: the previous session's stop when it still
+        rests at the venue (adopted, never doubled), a new one otherwise. More than one
+        resting stop against the position is a state nobody planned: entries wait and the
+        session halts for new orders until a person reconciles."""
+        try:
+            portfolio = await self._execution.get_portfolio()
+            working = await self._execution.get_orders(open_only=True)
+        except Exception as exc:
+            self._protection_lost(f"restored position; the venue cannot be read to protect it: {str(exc)[:200]}")
+            return
+        position = portfolio.positions.get(self._symbol)
+        if position is None or position.is_flat:
+            return
+        against = Side.SELL if position.quantity > 0 else Side.BUY
+        resting = [
+            order for order in working
+            if order.symbol == self._symbol and order.order_type is OrderType.STOP
+            and order.side is against and not order.state.is_terminal
+        ]
+        if len(resting) > 1:
+            self._block_entries(
+                "orders_unverified",
+                f"{len(resting)} stops rest at the venue against the restored position",
+            )
+            self.halt_new_orders(reason="more than one resting stop against a restored position")
+            return
+        if resting:
+            stop = resting[0]
+            self._protective = {
+                "order_id": stop.order_id,
+                "client_order_id": stop.client_order_id,
+                "quantity": stop.quantity - stop.filled_quantity,
+                "stop_price": stop.stop_price,
+            }
+        await self._sync_protective_stop(position.quantity)
+
