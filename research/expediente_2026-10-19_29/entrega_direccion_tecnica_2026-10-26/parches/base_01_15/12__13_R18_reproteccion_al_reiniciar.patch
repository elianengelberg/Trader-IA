+
+
+# ------------------------------------------------------------------- after a restart
+
+
+async def test_a_position_restored_after_a_restart_is_protected_before_its_first_bar(tmp_path: Path) -> None:
+    """Expected: the new session protects the restored position at start, so the first bar
+    it matches finds a stop; when the previous session's stop still rests at the venue it
+    is adopted — one stop, tracked, nothing for the reconciliation to call nobody's."""
+    from .test_account_restore import (
+        _db,
+        engine_for,
+        open_position,
+        persister,
+        rebuild,
+        register_run,
+        settle,
+    )
+    from .test_account_restore import (
+        build as build_restored,
+    )
+
+    db = _db(tmp_path)
+    await db.create_schema()
+    try:
+        runtime_a, engine_a, market_a, clock_a = build_restored(persist=persister(db))
+        await register_run(db, runtime_a.run_id)
+        await runtime_a.start()
+        await open_position(runtime_a, market_a)
+        market_a.advance()
+        await runtime_a._cycle_once()
+        await settle(runtime_a)
+        await runtime_a.stop()
+        await settle(runtime_a)
+        restore = await rebuild(db)
+        assert restore.complete and restore.has_position
+
+        # A fresh venue (the paper engine rebuilt from the journal holds no orders).
+        clock_b = SimulatedClock(clock_a.now())
+        market_b = FakeMarketData(market_a._candles, clock_b)
+        market_b.cursor = market_a.cursor
+        engine_b = engine_for(clock_b, live_settings())
+        engine_b.restore_portfolio(restore.portfolio_state())
+        runtime_b, _, _, _ = build_restored(account=restore, engine=engine_b, clock=clock_b, market=market_b)
+        await runtime_b.start()
+        try:
+            stops = [o for o in await engine_b.get_orders(open_only=True) if o.order_type is OrderType.STOP]
+            assert len(stops) == 1, "protected at start, before the first bar is matched"
+            market_b.advance()
+            await runtime_b._cycle_once()
+            assert len([o for o in await engine_b.get_orders(open_only=True) if o.order_type is OrderType.STOP]) == 1
+        finally:
+            await runtime_b.stop()
+
+        # The same venue as session A: its stop still rests there and is adopted.
+        resting = [o for o in await engine_a.get_orders(open_only=True) if o.order_type is OrderType.STOP]
+        assert len(resting) == 1, "the previous session left its stop at the venue"
+        runtime_c, _, _, _ = build_restored(account=restore, engine=engine_a, clock=clock_a, market=market_a)
+        await runtime_c.start()
+        try:
+            stops = [o for o in await engine_a.get_orders(open_only=True) if o.order_type is OrderType.STOP]
+            assert [o.order_id for o in stops] == [resting[0].order_id], "adopted, not doubled"
+            await runtime_c._reconcile()
+            assert runtime_c.machine.state is LiveState.RUNNING, "the adopted stop is tracked"
+        finally:
+            await runtime_c.stop()
+    finally:
+        await db.close()
