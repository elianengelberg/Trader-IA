index 0000000..109ec20
--- /dev/null
+++ b/tests/integration/test_live_session_lease.py
@@ -0,0 +1,94 @@
+"""One live session per account across processes — and no session on an unverifiable store.
+
+The paper path refuses to start while another process heartbeats an open paper run
+(Phase 1.3, G9). The live path had no such check: ``arm_live`` only asked whether *this*
+process already ran a session, so a second container over the same store and the same
+exchange account could arm a second live session — two runtimes sending entries and
+stops for one account. And the check itself failed open: when the store could not be
+read it answered "no other process", and the start went ahead.
+
+Expected outcomes, fixed before running: with another process's open live run carrying a
+fresh heartbeat, arming is refused and nothing is started; a stale heartbeat does not
+block; and when the store cannot be read, a paper start is refused rather than assumed
+alone.
+"""
+
+from __future__ import annotations
+
+from datetime import UTC, datetime, timedelta
+from pathlib import Path
+
+import pytest
+
+from tests.integration.test_live_api import _FakePublicFeed
+from tests.integration.test_mandatory_contracts import _armed_state
+from tia.core.errors import LiveActivationError
+from tia.persistence import RunRepository
+from tia.runtime.session_limits import LEASE_SECONDS, encode_heartbeat
+
+
+@pytest.fixture(autouse=True)
+def _feed(monkeypatch: pytest.MonkeyPatch) -> None:
+    import tia.data.providers.binance_public as binance_public
+
+    monkeypatch.setattr(binance_public, "BinancePublicProvider", _FakePublicFeed)
+
+
+async def _other_process_live_run(state, *, beat_age_seconds: float) -> None:  # type: ignore[no-untyped-def]
+    now = datetime.now(UTC)
+    async with state.database.session() as session:
+        await RunRepository(session).create(
+            run_id="run_other_live", mode="live", scenario="live", started_at=now - timedelta(hours=1),
+            initial_capital=100.0, seed=0, symbols=("BTC-USD",),
+            notes=encode_heartbeat("", at=now - timedelta(seconds=beat_age_seconds)),
+        )
+
+
+async def test_arming_is_refused_while_another_process_heartbeats_a_live_session(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from tia.live.gate import CONFIRMATION_PHRASE
+
+    state = await _armed_state(tmp_path, monkeypatch, start_ok=True)
+    try:
+        await _other_process_live_run(state, beat_age_seconds=5.0)
+        with pytest.raises(LiveActivationError, match="another process holds an active live session"):
+            await state.arm_live(operator="elian", confirmation=CONFIRMATION_PHRASE)
+        assert state.live_runtime is None, "a second live session was started over the account"
+    finally:
+        state.live_runtime = None
+        await state.shutdown()
+
+
+async def test_a_stale_live_heartbeat_does_not_block_arming(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    from tia.live.gate import CONFIRMATION_PHRASE
+
+    state = await _armed_state(tmp_path, monkeypatch, start_ok=True)
+    try:
+        await _other_process_live_run(state, beat_age_seconds=LEASE_SECONDS * 3)
+        result = await state.arm_live(operator="elian", confirmation=CONFIRMATION_PHRASE)
+        assert result["live"] is True
+    finally:
+        state.live_runtime = None
+        await state.shutdown()
+
+
+async def test_a_store_that_cannot_be_read_refuses_the_start_instead_of_assuming_it_is_alone(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from tests.integration.test_session_lease import _state
+
+    state = await _state(tmp_path)
+    await state.database.ensure_schema()
+
+    async def unreadable(self, *, mode: str):  # type: ignore[no-untyped-def]
+        raise ConnectionError("database is unreachable (injected)")
+
+    monkeypatch.setattr(RunRepository, "open_sessions", unreadable)
+    try:
+        with pytest.raises(LiveActivationError, match="cannot be read"):
+            await state.start_paper_realtime(actor="operator")
+        assert state.live_runtime is None
+    finally:
+        monkeypatch.undo()
+        await state.shutdown()
