diff --git a/tests/integration/test_dust_is_not_a_position.py b/tests/integration/test_dust_is_not_a_position.py
new file mode 100644
index 0000000..64300b9
--- /dev/null
+++ b/tests/integration/test_dust_is_not_a_position.py
@@ -0,0 +1,89 @@
+"""A remainder below one lot is dust, not a position the session must answer for.
+
+A spot venue that takes the buy commission in the base asset leaves the account holding
+less than the fill; the exit sells what the lot grid allows, and a remainder smaller than
+one lot stays behind — after almost every round trip. The session treated that remainder
+as a position nobody tracked: entries blocked and the session halted for new orders, an
+approved entry suppressed as "position already open", and a deadline that never found
+the session flat. No order can sell, protect or close a quantity below one lot, so nothing
+the session could do would ever clear it. (The paper engine charges fees in the quote
+asset, which is why no paper run ever showed this.)
+
+Expected outcomes, fixed before running: with a sub-lot remainder at the venue the session
+stays RUNNING with no entry block, takes an approved entry, and a deadline finds it flat;
+a holding of one lot or more that the session does not track still blocks and halts.
+"""
+
+from __future__ import annotations
+
+from datetime import timedelta
+
+from tia.domain.enums import Direction, MarketRegime
+from tia.domain.instruments import DEFAULT_UNIVERSE
+from tia.domain.portfolio import Position
+from tia.economics.expected_value import Outcome
+from tia.runtime.states import LiveState
+
+from .test_live_runtime import FakeExecution, build_runtime
+
+SYMBOL = "BTC-USD"
+LOT = float(DEFAULT_UNIVERSE.get(SYMBOL).lot_size)
+
+
+def _session_over(quantity: float):  # type: ignore[no-untyped-def]
+    execution = FakeExecution()
+    runtime, _, market = build_runtime(execution=execution)
+    execution.positions[SYMBOL] = Position(symbol=SYMBOL, quantity=quantity, average_price=0.0)
+    return runtime, execution, market
+
+
+def _seed(runtime) -> None:  # type: ignore[no-untyped-def]
+    runtime._edges.record_many([
+        Outcome(regime=regime, direction=direction, confidence=0.65, net_return_bps=200.0)
+        for regime in MarketRegime for direction in (Direction.LONG, Direction.SHORT) for _ in range(40)
+    ])
+
+
+async def test_a_sub_lot_remainder_neither_blocks_nor_halts_and_an_entry_still_happens() -> None:
+    runtime, execution, market = _session_over(LOT / 4)
+    await runtime.start()
+    try:
+        _seed(runtime)
+        before = execution.submissions
+        for _ in range(300):
+            market.advance()
+            await runtime._cycle_once()
+            if execution.submissions > before:
+                break
+        assert "position_unverified" not in runtime.entry_blocks
+        assert runtime.counters["suppressed_position_open"] == 0, "dust is not an open position"
+        assert execution.submissions > before, "an approved entry was taken"
+    finally:
+        await runtime.stop()
+
+
+async def test_a_deadline_finds_a_session_with_only_dust_flat() -> None:
+    runtime, _, market = _session_over(LOT / 4)
+    await runtime.start()
+    try:
+        market.advance()
+        await runtime._cycle_once()
+        runtime._session_deadline = runtime._clock.now() - timedelta(seconds=1)
+        market.advance()
+        await runtime._cycle_once()
+        assert runtime.machine.state in {LiveState.STOPPING, LiveState.STOPPED}, "flat at the deadline: finished"
+    finally:
+        await runtime.stop()
+
+
+async def test_an_untracked_holding_of_a_lot_or_more_still_blocks_and_halts() -> None:
+    runtime, _, market = _session_over(LOT)
+    await runtime.start()
+    try:
+        for _ in range(3):
+            market.advance()
+            await runtime._cycle_once()
+        assert "position_unverified" in runtime.entry_blocks
+        assert runtime.machine.state is LiveState.HALT_NEW_ORDERS
+    finally:
+        await runtime.stop()
