diff --git a/tests/integration/test_emergency_controls_protection.py b/tests/integration/test_emergency_controls_protection.py
new file mode 100644
index 0000000..f3eab0b
--- /dev/null
+++ b/tests/integration/test_emergency_controls_protection.py
@@ -0,0 +1,146 @@
+"""The emergency controls must not take away the protection of a position they leave open.
+
+The kill switch stops everything and does not close the position: it used to cancel every
+resting order, its protective stop included, and land in SAFE_MODE, where nothing is
+managed — a position left open with no stop for as long as the operator took to come back.
+The emergency flatten cancels the stop to close at market; a close the venue refused left
+the position without a stop until the next cycle, after a bar had been matched without it.
+And a paused or safe-moded paper session stopped its own simulated venue: a stop resting
+there never fired, however far the price went.
+
+Expected outcomes, fixed before running: after the kill switch the stop still rests and the
+position is reported protected; a position the kill switch leaves with nothing at the venue
+is counted unprotected; a refused emergency close is followed, within the same call, by a
+stop; and a stop resting while the session stands still fires on the bar that crosses it.
+"""
+
+from __future__ import annotations
+
+from tia.domain.enums import OrderType, Side, TimeInForce
+from tia.domain.orders import OrderIntent
+from tia.runtime.states import LiveState
+
+from .test_account_restore import SYMBOL, build, open_position
+
+
+def _stops(engine):  # type: ignore[no-untyped-def]
+    return [o for o in engine.resting_orders(SYMBOL) if o.order_type is OrderType.STOP]
+
+
+def _held(engine) -> float:  # type: ignore[no-untyped-def]
+    position = engine.portfolio.positions.get(SYMBOL)
+    return 0.0 if position is None or position.is_flat else float(position.quantity)
+
+
+async def _protected_position(runtime, engine, market):  # type: ignore[no-untyped-def]
+    """An open long with its stop resting a hair under the price, so the next bars cross it."""
+    await runtime.start()
+    await open_position(runtime, market)
+    market.advance()
+    await runtime._cycle_once()
+    price = market._candles[market.cursor - 1].close
+    runtime._planned_exit["stop"] = round(price * 0.9995, 2)
+    market.advance()
+    await runtime._cycle_once()
+    stops = _stops(engine)
+    assert len(stops) == 1 and _held(engine) > 0
+    return stops[0]
+
+
+async def _until_crossed(runtime, market, level: float, bars: int = 200) -> None:  # type: ignore[no-untyped-def]
+    for _ in range(bars):
+        market.advance()
+        await runtime._cycle_once()
+        if market._candles[market.cursor - 1].low <= level:
+            return
+    raise AssertionError("the price never crossed the stop level")
+
+
+async def test_the_kill_switch_keeps_the_stop_of_the_position_it_does_not_close() -> None:
+    runtime, engine, market, _ = build()
+    stop = await _protected_position(runtime, engine, market)
+
+    result = await runtime.kill_switch(reason="drill", actor="operator")
+
+    assert runtime.state is LiveState.SAFE_MODE
+    assert [o.order_id for o in _stops(engine)] == [stop.order_id], "the stop still rests"
+    assert runtime.snapshot()["position"]["protected"] is True
+    assert result["kept_reducing_orders"] == [stop.client_order_id]
+    assert runtime.counters["unprotected_positions"] == 0
+    await runtime.stop(reason="end")
+
+
+async def test_the_kill_switch_still_cancels_what_could_add_exposure() -> None:
+    runtime, engine, market, _ = build()
+    stop = await _protected_position(runtime, engine, market)
+    price = market._candles[market.cursor - 1].close
+    foreign = await engine.submit_order(OrderIntent(
+        intent_id="manual", client_order_id="manual-buy-1", signal_id="manual", risk_decision_id="manual",
+        symbol=SYMBOL, side=Side.BUY, quantity=0.01, order_type=OrderType.LIMIT, limit_price=round(price * 0.9, 2),
+        time_in_force=TimeInForce.GTC, created_at=runtime._clock.now(),
+    ))
+    assert not foreign.state.is_terminal
+
+    result = await runtime.kill_switch(reason="drill", actor="operator")
+
+    resting = {o.client_order_id for o in engine.resting_orders(SYMBOL)}
+    assert "manual-buy-1" not in resting, "an order that adds exposure is cancelled"
+    assert stop.client_order_id in resting
+    assert result["cancelled_orders"] == 1
+    await runtime.stop(reason="end")
+
+
+async def test_a_kill_switch_over_a_position_with_nothing_at_the_venue_says_it_is_unprotected() -> None:
+    runtime, engine, market, _ = build()
+    stop = await _protected_position(runtime, engine, market)
+    await engine.cancel_order(stop.order_id)  # gone behind the session's back
+    runtime._protective = None
+
+    await runtime.kill_switch(reason="drill", actor="operator")
+
+    assert runtime.state is LiveState.SAFE_MODE, "saying so does not take the session out of SAFE_MODE"
+    assert runtime.counters["unprotected_positions"] == 1
+    assert "position_unprotected" in runtime.entry_blocks
+    assert runtime.last_error.startswith("position unprotected: kill switch")
+    await runtime.stop(reason="end")
+
+
+async def test_a_stop_kept_through_the_kill_switch_fires_while_the_session_stands_still() -> None:
+    runtime, engine, market, _ = build()
+    stop = await _protected_position(runtime, engine, market)
+    await runtime.kill_switch(reason="drill", actor="operator")
+
+    await _until_crossed(runtime, market, float(stop.stop_price))
+
+    assert _held(engine) == 0.0, "the venue does not pause: the stop closed the position"
+    assert runtime.state is LiveState.SAFE_MODE
+    await runtime.stop(reason="end")
+
+
+async def test_a_paused_session_s_stop_fires_on_the_bar_that_crosses_it() -> None:
+    runtime, engine, market, _ = build()
+    stop = await _protected_position(runtime, engine, market)
+    runtime.pause(actor="operator")
+    bars_before = runtime.counters["bars"]
+
+    await _until_crossed(runtime, market, float(stop.stop_price))
+
+    assert _held(engine) == 0.0
+    assert runtime.state is LiveState.PAUSED
+    assert runtime.counters["bars"] == bars_before, "standing still, the session decided nothing"
+    await runtime.stop(reason="end")
+
+
+async def test_a_refused_emergency_close_puts_the_stop_back_in_the_same_call() -> None:
+    runtime, engine, market, _ = build()
+    await _protected_position(runtime, engine, market)
+    real = engine._should_reject
+    engine._should_reject = lambda order: True if order.reduce_only and order.order_type is OrderType.MARKET else real(order)
+
+    result = await runtime.emergency_flatten(reason="drill", actor="operator")
+    engine._should_reject = real
+
+    assert [c["state"] for c in result["closing_orders"]] == ["rejected"]
+    assert len(_stops(engine)) == 1, "protected again before any bar is matched"
+    assert runtime.snapshot()["position"]["protected"] is True
+    await runtime.stop(reason="end")
