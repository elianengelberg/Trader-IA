+    def _live_session_metrics(self) -> list[str]:
+        """The 24/7 session — the one that holds positions — in the exposition. The lines
+        above describe the scenario engine only; without these, a scrape could not tell a
+        session holding an unprotected position, or losing writes, from one that is fine."""
+        live = self.live_runtime
+        lines = [
+            "# HELP tia_live_session 1 when a 24/7 session (paper-realtime or live) exists",
+            "# TYPE tia_live_session gauge",
+            f"tia_live_session {0 if live is None else 1}",
+        ]
+        if live is None:
+            return lines
+        try:
+            snap = live.snapshot()
+        except Exception as exc:  # the exposition must still say something is wrong
+            _log.warning("live_metrics_unavailable", error=str(exc)[:200])
+            return [*lines, "# TYPE tia_live_snapshot_error gauge", "tia_live_snapshot_error 1"]
+        position = snap.get("position") or {}
+        persistence = snap.get("persistence") or {}
+        held = bool(position.get("open"))
+        lines += [
+            "# HELP tia_live_state The session's state (1 on the current one)",
+            "# TYPE tia_live_state gauge",
+            f'tia_live_state{{state="{snap.get("state")}"}} 1',
+            "# HELP tia_live_position_open 1 when the session holds a position",
+            "# TYPE tia_live_position_open gauge",
+            f"tia_live_position_open {int(held)}",
+            "# HELP tia_live_position_unprotected 1 when it holds a position no stop the venue confirmed covers",
+            "# TYPE tia_live_position_unprotected gauge",
+            f"tia_live_position_unprotected {int(held and not position.get('protected'))}",
+            "# HELP tia_live_entry_blocks Reasons new entries are currently refused",
+            "# TYPE tia_live_entry_blocks gauge",
+            f"tia_live_entry_blocks {len(snap.get('entry_blocks') or {})}",
+            "# TYPE tia_live_heartbeat_age_seconds gauge",
+            f"tia_live_heartbeat_age_seconds {snap.get('heartbeat_age_seconds', 0)}",
+            "# TYPE tia_live_market_data_age_seconds gauge",
+            f"tia_live_market_data_age_seconds {snap.get('market_data_age_seconds', 0)}",
+        ]
+        for name in ("scheduled", "confirmed", "failed", "in_flight"):
+            if name in persistence:
+                kind = "gauge" if name == "in_flight" else "counter"
+                lines += [f"# TYPE tia_live_persistence_{name} {kind}", f"tia_live_persistence_{name} {persistence[name]}"]
+        if "complete" in persistence:
+            lines += ["# HELP tia_live_persistence_complete 0 once a write was lost or is still in flight",
+                      "# TYPE tia_live_persistence_complete gauge",
+                      f"tia_live_persistence_complete {int(bool(persistence['complete']))}"]
+        for name, value in (snap.get("counters") or {}).items():
+            if isinstance(value, int | float) and not isinstance(value, bool):
+                lines += [f"# TYPE tia_live_{name} counter", f"tia_live_{name} {value}"]
+        return lines
+
