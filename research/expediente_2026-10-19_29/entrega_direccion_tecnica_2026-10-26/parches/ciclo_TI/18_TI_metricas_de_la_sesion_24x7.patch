index 0000000..83eecdd
--- /dev/null
+++ b/tests/integration/test_live_metrics.py
@@ -0,0 +1,73 @@
+"""The metrics exposition describes the 24/7 session, not only the scenario engine.
+
+``/api/metrics`` used to read the scenario engine alone: with only the paper-realtime (or
+live) session running — the one holding positions — a scrape saw ``tia_up 1`` and empty
+counters, so an alert on an unprotected position or a lost write had nothing to fire on.
+
+Expected outcomes, fixed before running: with no session, ``tia_live_session 0`` and no
+session series; with one, its state, whether it holds a position, whether that position is
+unprotected, its entry blocks, its persistence completeness and its counters.
+"""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+import pytest
+
+from tests.integration.test_live_api import _FakePublicFeed, _settings
+from tia.api.state import AppState
+from tia.core.config import LiveConfig
+
+from .test_account_restore import build, open_position
+
+
+@pytest.fixture(autouse=True)
+def _feed(monkeypatch: pytest.MonkeyPatch) -> None:
+    import tia.data.providers.binance_public as binance_public
+
+    monkeypatch.setattr(binance_public, "BinancePublicProvider", _FakePublicFeed)
+
+
+def _value(text: str, series: str) -> str | None:
+    for line in text.splitlines():
+        if line.startswith(series + " "):
+            return line.split(" ", 1)[1]
+    return None
+
+
+async def test_the_exposition_carries_the_session_that_holds_positions(tmp_path: Path) -> None:
+    state = AppState(_settings(tmp_path, live=LiveConfig(market_stream=False)))
+    await state.database.ensure_schema()
+    runtime, engine, market, _ = build()
+    started = False
+    try:
+        assert _value(state.prometheus_metrics(), "tia_live_session") == "0"
+        assert "tia_live_state" not in state.prometheus_metrics()
+
+        await runtime.start()
+        started = True
+        await open_position(runtime, market)
+        market.advance()
+        await runtime._cycle_once()
+        state.live_runtime = runtime
+        text = state.prometheus_metrics()
+        assert _value(text, "tia_live_session") == "1"
+        assert _value(text, f'tia_live_state{{state="{runtime.state.value}"}}') == "1"
+        assert _value(text, "tia_live_position_open") == "1"
+        assert _value(text, "tia_live_position_unprotected") == "0"
+        assert _value(text, "tia_live_persistence_complete") == "1"
+        assert _value(text, "tia_live_orders") == str(runtime.counters["orders"])
+
+        stop = runtime._protective
+        await engine.cancel_order(stop["order_id"])  # the stop is gone
+        runtime._protective = None
+        runtime._block_entries("position_unprotected", "drill")
+        text = state.prometheus_metrics()
+        assert _value(text, "tia_live_position_unprotected") == "1"
+        assert _value(text, "tia_live_entry_blocks") == "1"
+    finally:
+        if started:
+            await runtime.stop(reason="end")
+        state.live_runtime = None
+        await state.shutdown()
