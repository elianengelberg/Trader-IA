diff --git a/infra/migrations/versions/0008_incident_kind_length.py b/infra/migrations/versions/0008_incident_kind_length.py
new file mode 100644
index 0000000..e781699
--- /dev/null
+++ b/infra/migrations/versions/0008_incident_kind_length.py
@@ -0,0 +1,58 @@
+"""Schema v7 → v8: an incident's kind fits every kind the runtime writes (R24-H1).
+
+``incidents.kind`` was VARCHAR(32). The live runtime records ``entries_blocked:<cause>``
+whenever it refuses entries, and three of those causes make a kind longer than 32
+characters (``entries_blocked:position_unverified`` is 35). SQLite does not enforce a
+VARCHAR length, so every test passed; PostgreSQL refuses the row, the write fails in the
+background, and the incident — the record of *why* entries stopped — was lost, said only
+in a log line.
+
+Widened to 64; no row is rewritten and the index on the column stays. The downgrade
+narrows it back only when every stored kind fits in 32: otherwise it refuses and says how
+many rows would be cut, instead of truncating the history it exists to keep.
+"""
+
+from __future__ import annotations
+
+import sqlalchemy as sa
+from alembic import op
+
+revision = "0008"
+down_revision = "0007"
+branch_labels = None
+depends_on = None
+
+OLD_LENGTH = 32
+NEW_LENGTH = 64
+
+
+def upgrade() -> None:
+    with op.batch_alter_table("incidents") as batch:
+        batch.alter_column(
+            "kind",
+            existing_type=sa.String(OLD_LENGTH),
+            type_=sa.String(NEW_LENGTH),
+            existing_nullable=False,
+        )
+    op.get_bind().execute(sa.text("UPDATE schema_info SET version = 8 WHERE id = 1"))
+
+
+def downgrade() -> None:
+    bind = op.get_bind()
+    longer = bind.execute(
+        sa.text("SELECT count(*) FROM incidents WHERE length(kind) > :limit"),
+        {"limit": OLD_LENGTH},
+    ).scalar()
+    if longer:
+        raise RuntimeError(
+            f"{longer} incident(s) have a kind longer than {OLD_LENGTH} characters; narrowing "
+            "incidents.kind would cut them. Export or re-file them before downgrading."
+        )
+    with op.batch_alter_table("incidents") as batch:
+        batch.alter_column(
+            "kind",
+            existing_type=sa.String(NEW_LENGTH),
+            type_=sa.String(OLD_LENGTH),
+            existing_nullable=False,
+        )
+    bind.execute(sa.text("UPDATE schema_info SET version = 7 WHERE id = 1"))
