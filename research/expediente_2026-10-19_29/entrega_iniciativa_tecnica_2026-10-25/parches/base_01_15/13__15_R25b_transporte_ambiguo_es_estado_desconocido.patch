diff --git a/tests/unit/test_binance_ambiguous_transport.py b/tests/unit/test_binance_ambiguous_transport.py
new file mode 100644
index 0000000..7d99a6c
--- /dev/null
+++ b/tests/unit/test_binance_ambiguous_transport.py
@@ -0,0 +1,71 @@
+"""A transport failure after an order request may have left is an unknown order state.
+
+The adapter already reports a timeout on an order as UNKNOWN and never retries it. Other
+transport failures were all reported as an outage (``ProviderUnavailableError``), which the
+live session treats as "nothing happened": a connection reset while the venue's answer was on
+its way left an order the venue may hold and the session did not look for. Only a failure to
+connect at all is known to have sent nothing; reads stay an outage either way.
+
+Expected outcomes, fixed before running: order and cancel requests that fail after the
+connection was made raise ``ReconciliationError`` (one attempt, no retry); a failed connect
+and any failed read raise ``ProviderUnavailableError``.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import pytest
+
+from tia.core.errors import ProviderUnavailableError, ReconciliationError
+
+from .test_binance_live import ACK_RESPONSE, intent, provider
+
+AFTER_SENDING = [
+    httpx.ReadError("connection reset by peer"),
+    httpx.RemoteProtocolError("server disconnected without sending a response"),
+    httpx.WriteError("broken pipe"),
+]
+
+
+def failing(exc: httpx.HTTPError, attempts: list[str], *, only: str | None = None) -> Any:
+    def handler(request: httpx.Request) -> httpx.Response:
+        attempts.append(request.method)
+        if only is None or request.method == only:
+            exc.request = request
+            raise exc
+        return httpx.Response(200, json=ACK_RESPONSE)
+    return handler
+
+
+@pytest.mark.parametrize("exc", AFTER_SENDING, ids=lambda e: type(e).__name__)
+async def test_an_order_that_may_have_reached_the_venue_is_unknown_not_unsent(exc: httpx.HTTPError) -> None:
+    attempts: list[str] = []
+    with pytest.raises(ReconciliationError, match="UNKNOWN"):
+        await provider(failing(exc, attempts)).submit_order(intent())
+    assert attempts == ["POST"], "one request, never retried"
+
+
+async def test_a_connection_that_was_never_made_sent_nothing() -> None:
+    attempts: list[str] = []
+    with pytest.raises(ProviderUnavailableError):
+        await provider(failing(httpx.ConnectError("no route"), attempts)).submit_order(intent())
+    assert attempts == ["POST"]
+
+
+async def test_a_cancel_that_may_have_reached_the_venue_is_unknown() -> None:
+    attempts: list[str] = []
+    adapter = provider(failing(httpx.ReadError("connection reset by peer"), attempts, only="DELETE"))
+    order = await adapter.submit_order(intent())
+    with pytest.raises(ReconciliationError, match="UNKNOWN"):
+        await adapter.cancel_order(order.order_id)
+    assert attempts == ["POST", "DELETE"]
+
+
+async def test_a_failed_read_is_an_outage() -> None:
+    attempts: list[str] = []
+    adapter = provider(failing(httpx.ReadError("connection reset by peer"), attempts, only="GET"))
+    with pytest.raises(ProviderUnavailableError):
+        await adapter.get_orders(open_only=True, symbol="BTC-USD")
+    assert attempts == ["GET"]
