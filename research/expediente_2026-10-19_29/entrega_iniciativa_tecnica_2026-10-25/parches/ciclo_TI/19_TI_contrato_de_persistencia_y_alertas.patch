diff --git a/tests/integration/test_alert_delivery.py b/tests/integration/test_alert_delivery.py
new file mode 100644
index 0000000..3b718f0
--- /dev/null
+++ b/tests/integration/test_alert_delivery.py
@@ -0,0 +1,97 @@
+"""Alerts reach the operator when the store is down, and an error answer is not a delivery.
+
+The webhook was called from inside the incident's database write, after the row landed: with
+the store down — exactly when an operator must hear about it — no alert went out. And the
+webhook's answer was never looked at: a 500 counted as delivered.
+
+Expected outcomes, fixed before running: with every database session refused, an incident
+still reaches the webhook; a webhook answering 500 is counted as a failed alert.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import contextlib
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+import httpx
+import pytest
+
+from tests.integration.test_live_api import _FakePublicFeed, _settings
+from tia.api.state import AppState
+from tia.core.config import LiveConfig
+
+
+@pytest.fixture(autouse=True)
+def _feed(monkeypatch: pytest.MonkeyPatch) -> None:
+    import tia.data.providers.binance_public as binance_public
+
+    monkeypatch.setattr(binance_public, "BinancePublicProvider", _FakePublicFeed)
+
+
+def _webhook(monkeypatch: pytest.MonkeyPatch, status: int) -> list[dict[str, Any]]:
+    sent: list[dict[str, Any]] = []
+
+    class _Hook:
+        def __init__(self, *args: Any, **kwargs: Any) -> None: ...
+
+        async def __aenter__(self) -> _Hook:
+            return self
+
+        async def __aexit__(self, *args: Any) -> bool:
+            return False
+
+        async def post(self, url: str, json: dict[str, Any] | None = None) -> httpx.Response:
+            sent.append(json or {})
+            return httpx.Response(status)
+
+    monkeypatch.setattr(httpx, "AsyncClient", _Hook)
+    return sent
+
+
+def _state(tmp_path: Path) -> AppState:
+    settings = _settings(tmp_path, live=LiveConfig(market_stream=False))
+    return AppState(settings.model_copy(update={"observability": settings.observability.model_copy(
+        update={"alert_webhook_url": "https://alerts.example/hook"})}))
+
+
+INCIDENT = {"incident_id": "i-1", "at": datetime.now(UTC), "kind": "protective_stop_failed", "actor": "system",
+            "reason": "drill", "run_id": "r", "detail": {}}
+
+
+async def test_an_incident_reaches_the_webhook_with_the_store_down(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    sent = _webhook(monkeypatch, 200)
+    state = _state(tmp_path)
+    await state.database.ensure_schema()
+    try:
+        @contextlib.asynccontextmanager
+        async def broken_session():  # type: ignore[no-untyped-def]
+            raise RuntimeError("database is down")
+            yield  # pragma: no cover
+
+        monkeypatch.setattr(state.database, "session", broken_session)
+        await state._persist("incident", dict(INCIDENT))
+        for _ in range(5):
+            await asyncio.sleep(0)
+        assert [s["kind"] for s in sent] == ["protective_stop_failed"], "the alert went out anyway"
+        assert state.persistence_status()["failures"] == 1, "and the failed write is still counted"
+    finally:
+        monkeypatch.undo()
+        await state.shutdown()
+
+
+async def test_a_webhook_answering_an_error_is_a_failed_alert(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    sent = _webhook(monkeypatch, 500)
+    state = _state(tmp_path)
+    await state.database.ensure_schema()
+    try:
+        await state._persist("incident", dict(INCIDENT))
+        for _ in range(5):
+            await asyncio.sleep(0)
+        assert sent, "the webhook was called"
+        assert state._alert_failures == 1
+        assert "tia_alert_failures_total 1" in state.prometheus_metrics()
+    finally:
+        await state.shutdown()
