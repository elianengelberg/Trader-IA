             await engine.stop()
-        assert engine.persistence_flushed is True, "failed writes are finished writes"
+        # Finished, but not landed: a run with a failed write does not call its record
+        # complete (N3, the live session's rule since R19).
+        assert engine.persistence_flushed is False, "failed writes leave the record incomplete"
         assert engine.counters.persist_failures >= 1
         assert engine.counters.errors == 0, "a store failure is not a loop error"
 
@@ -156,3 +158,22 @@ async def test_stop_is_idempotent() -> None:
     await engine.stop()
     assert engine.state is RuntimeState.STOPPED and engine.stopped_at is not None
     assert first is not None and engine.stopped_at >= first
+
+
+async def test_a_run_whose_write_failed_does_not_report_its_record_complete() -> None:
+    """N3: the scenario engine counted a failed write and still flushed ``True`` — its run
+    record called complete with a fill or an outcome missing. Expected, fixed before
+    running: ``persistence_flushed`` is False and the stop says the record is incomplete."""
+    async def persist(kind: str, payload: dict[str, Any]) -> None:
+        if kind == "fill":
+            raise OSError("store refused the fill")
+
+    engine = _engine(persist)
+    await engine.start()
+    try:
+        await _until(lambda: engine.counters.persist_failures >= 1 or not engine.is_running)
+    finally:
+        await engine.stop()
+    assert engine.counters.persist_failures >= 1, "the scenario produced no fill"
+    assert engine.persistence_flushed is False
+    assert "failed during the run" in engine.last_error and "incomplete" in engine.last_error
diff --git a/tests/integration/test_session_persistence_contract.py b/tests/integration/test_session_persistence_contract.py
new file mode 100644
index 0000000..80db598
--- /dev/null
+++ b/tests/integration/test_session_persistence_contract.py
@@ -0,0 +1,82 @@
+"""A write the store refuses reaches the session's own record of its writes — in production.
+
+The session counts a write as failed when the coroutine it scheduled raises (R19: the
+flush says "complete" only with none in flight and none failed). The tests that proved it
+handed the session a store double that raises. The application hands it
+``AppState._persist``, which absorbed every failure and returned normally — so in
+production every refused write was counted as confirmed, the flush said complete, and the
+stop's "the record is incomplete" never fired. The global counter saw the failure; the
+session, whose record it was, did not.
+
+Expected outcomes, fixed before running: with the application's own dispatcher and a store
+that refuses writes, the session counts the write as failed, the flush does not say
+complete, and the application's global counter still counts it.
+"""
+
+from __future__ import annotations
+
+import contextlib
+from datetime import UTC, datetime
+from pathlib import Path
+
+import pytest
+
+from tests.integration.test_live_api import _FakePublicFeed, _settings
+from tia.api.state import AppState
+from tia.core.config import LiveConfig
+
+from .test_account_restore import build
+
+
+@pytest.fixture(autouse=True)
+def _feed(monkeypatch: pytest.MonkeyPatch) -> None:
+    import tia.data.providers.binance_public as binance_public
+
+    monkeypatch.setattr(binance_public, "BinancePublicProvider", _FakePublicFeed)
+
+
+async def test_a_refused_write_is_a_failed_write_for_the_session(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    state = AppState(_settings(tmp_path, live=LiveConfig(market_stream=False)))
+    await state.database.ensure_schema()
+    runtime, *_ = build(persist=state.session_persist)
+    await runtime.start()
+    try:
+        assert await runtime.flush_persistence(timeout_seconds=5) is True
+
+        @contextlib.asynccontextmanager
+        async def broken_session():  # type: ignore[no-untyped-def]
+            raise RuntimeError("database is locked")
+            yield  # pragma: no cover
+
+        monkeypatch.setattr(state.database, "session", broken_session)
+        runtime._save("incident", {"incident_id": "drill", "at": datetime.now(UTC), "kind": "drill",
+                                   "actor": "system", "reason": "drill", "run_id": runtime.run_id, "detail": {}})
+        flushed = await runtime.flush_persistence(timeout_seconds=5)
+        report = runtime.persistence_report()
+        monkeypatch.undo()
+
+        lost = {w["kind"] for w in report["lost"]}
+        assert "incident" in lost and report["complete"] is False, "the session knows its write was lost"
+        assert flushed is False
+        assert state.persistence_status()["failures"] == report["failed"], "and the application counts the same"
+    finally:
+        await runtime.stop(reason="end")
+        await state.shutdown()
+
+
+async def test_the_dispatcher_the_application_keeps_for_itself_still_absorbs(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    """The market-making services await the dispatcher inline and rely on it not raising."""
+    state = AppState(_settings(tmp_path, live=LiveConfig(market_stream=False)))
+    await state.database.ensure_schema()
+    try:
+        @contextlib.asynccontextmanager
+        async def broken_session():  # type: ignore[no-untyped-def]
+            raise RuntimeError("database is locked")
+            yield  # pragma: no cover
+
+        monkeypatch.setattr(state.database, "session", broken_session)
+        await state._persist("log", {"run_id": "r", "level": "INFO", "at": datetime.now(UTC)})
+        assert state.persistence_status()["failures"] == 1
+    finally:
+        monkeypatch.undo()
+        await state.shutdown()
