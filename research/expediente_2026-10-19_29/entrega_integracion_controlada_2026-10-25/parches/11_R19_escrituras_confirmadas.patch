diff --git a/tests/integration/test_persistence_completeness.py b/tests/integration/test_persistence_completeness.py
new file mode 100644
index 0000000..75335e5
--- /dev/null
+++ b/tests/integration/test_persistence_completeness.py
@@ -0,0 +1,162 @@
+"""R19: "flushed" means every scheduled write was confirmed — not that nothing is left to wait for.
+
+Definition used here and in :meth:`LiveRuntime.flush_persistence`: a write is *scheduled*
+when the session hands it to the store, *in flight* until the store's coroutine ends,
+*confirmed* when it returned, *lost* when it raised or was cancelled. The record is
+*complete* when nothing is in flight and nothing was lost. Before, a write the store
+refused was logged at warning level and counted as finished, so a stop reported a clean
+record over a store that had dropped fills.
+
+Expected, fixed before running: a lost write (async, sync, cancelled) makes the flush
+False, the stop unclean and the report name it with its ids; a slow write is in flight
+until it lands, then complete; a clean session is complete; the lost writes carry what a
+recovery needs to write them again, and writing them again completes the store.
+"""
+
+from __future__ import annotations
+
+import asyncio
+from datetime import UTC, datetime
+from pathlib import Path
+from typing import Any
+
+from tia.persistence import Database, IncidentRepository
+
+from .test_live_runtime import build_runtime_paper
+
+
+def _incident(i: int) -> dict[str, Any]:
+    return {"incident_id": f"inc-{i}", "at": datetime.now(UTC), "kind": "halt_new_orders",
+            "actor": "system", "reason": f"r19 test {i}", "run_id": "run", "detail": {}}
+
+
+async def test_a_write_the_store_refuses_makes_the_flush_and_the_stop_say_so() -> None:
+    runtime, _, _ = build_runtime_paper()
+
+    async def store(kind: str, payload: dict[str, Any]) -> None:
+        if payload.get("incident_id") == "inc-2":
+            raise RuntimeError("store refused the row")
+
+    runtime._persist = store
+    for i in range(4):
+        runtime._save("incident", _incident(i))
+    assert await runtime.flush_persistence(timeout_seconds=5.0) is False
+    report = runtime.persistence_report()
+    assert (report["scheduled"], report["confirmed"], report["failed"], report["in_flight"]) == (4, 3, 1, 0)
+    assert report["lost"][0]["ids"] == {"incident_id": "inc-2", "run_id": "run"}
+    assert "store refused the row" in report["lost"][0]["error"]
+    await runtime.start()
+    await runtime.stop()
+    assert runtime.persistence_flushed is False
+    assert "failed" in runtime.last_error and "incomplete" in runtime.last_error
+    assert runtime.snapshot()["persistence"]["complete"] is False
+
+
+async def test_a_synchronous_store_failure_is_a_lost_write_too() -> None:
+    runtime, _, _ = build_runtime_paper()
+
+    def store(kind: str, payload: dict[str, Any]) -> None:
+        raise RuntimeError("store down (sync)")
+
+    runtime._persist = store
+    runtime._save("incident", _incident(1))
+    assert await runtime.flush_persistence(timeout_seconds=1.0) is False
+    assert runtime.persistence_report()["failed"] == 1
+
+
+async def test_a_slow_write_is_in_flight_until_it_lands() -> None:
+    runtime, _, _ = build_runtime_paper()
+    release = asyncio.Event()
+
+    async def store(kind: str, payload: dict[str, Any]) -> None:
+        await release.wait()
+
+    runtime._persist = store
+    runtime._save("incident", _incident(1))
+    assert await runtime.flush_persistence(timeout_seconds=0.1) is False
+    assert runtime.persistence_report()["in_flight"] == 1
+    release.set()
+    assert await runtime.flush_persistence(timeout_seconds=5.0) is True
+    assert runtime.persistence_report()["complete"] is True
+
+
+async def test_a_write_cancelled_before_it_landed_is_lost() -> None:
+    runtime, _, _ = build_runtime_paper()
+
+    async def store(kind: str, payload: dict[str, Any]) -> None:
+        await asyncio.sleep(10)
+
+    runtime._persist = store
+    runtime._save("incident", _incident(1))
+    await asyncio.sleep(0)  # the write has started: it is cancelled mid-flight, as at a shutdown
+    for task in list(runtime._persist_tasks):
+        task.cancel()
+    await asyncio.sleep(0)
+    await asyncio.sleep(0)
+    assert await runtime.flush_persistence(timeout_seconds=1.0) is False
+    report = runtime.persistence_report()
+    assert report["failed"] == 1 and "Cancelled" in report["lost"][0]["error"]
+
+
+async def test_a_clean_session_is_complete() -> None:
+    runtime, _, market = build_runtime_paper()
+    written: list[str] = []
+
+    async def store(kind: str, payload: dict[str, Any]) -> None:
+        written.append(kind)
+
+    runtime._persist = store
+    await runtime.start()
+    market.advance()
+    await runtime._cycle_once()  # at least the heartbeat is written
+    await runtime.stop()
+    assert runtime.persistence_flushed is True and runtime.last_error == ""
+    report = runtime.persistence_report()
+    assert report["complete"] and report["scheduled"] == report["confirmed"] == len(written) > 0
+
+
+async def test_the_lost_writes_can_be_written_again_and_complete_the_store(tmp_path: Path) -> None:
+    """Recovery: what the session kept of its lost writes is enough to write them again,
+    and writing them again is idempotent with what did land (the store's own keys)."""
+    db = Database(f"sqlite+aiosqlite:///{tmp_path / 'r19.db'}")
+    await db.create_schema()
+    outage = {"on": True}
+
+    async def store(kind: str, payload: dict[str, Any]) -> None:
+        if outage["on"] and int(payload["incident_id"].split("-")[1]) % 3 == 0:
+            raise RuntimeError("store outage")
+        async with db.session() as session:
+            await IncidentRepository(session).record(payload)
+
+    try:
+        runtime, _, _ = build_runtime_paper()
+        runtime._persist = store
+        for i in range(10):
+            runtime._save("incident", _incident(i))
+        assert await runtime.flush_persistence(timeout_seconds=5.0) is False
+        lost = runtime.lost_writes()
+        assert sorted(r["payload"]["incident_id"] for r in lost) == ["inc-0", "inc-3", "inc-6", "inc-9"]
+        outage["on"] = False
+        for record in lost:
+            await store(record["kind"], record["payload"])
+        async with db.session() as session:
+            stored = {r.incident_id for r in await IncidentRepository(session).recent(limit=100)}
+        assert stored == {f"inc-{i}" for i in range(10)}
+    finally:
+        await db.close()
+
+
+async def test_a_write_that_failed_a_moment_ago_is_counted_before_its_callback_runs() -> None:
+    """The write fails on the loop's last turn; its done-callback has not run yet. The
+    report and the flush still see it lost — they do not wait for the callback's turn."""
+    runtime, _, _ = build_runtime_paper()
+
+    async def store(kind: str, payload: dict[str, Any]) -> None:
+        raise RuntimeError("store refused the row")
+
+    runtime._persist = store
+    runtime._save("incident", _incident(1))
+    await asyncio.sleep(0)  # the write runs and fails; its callbacks are queued behind us
+    report = runtime.persistence_report()
+    assert report["failed"] == 1 and report["complete"] is False
+    assert await runtime.flush_persistence(timeout_seconds=1.0) is False
