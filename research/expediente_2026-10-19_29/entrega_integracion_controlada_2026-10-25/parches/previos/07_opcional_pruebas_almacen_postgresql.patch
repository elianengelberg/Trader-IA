+"""The backtest store against PostgreSQL: transactions, recovery and the provenance rule (R24).
+
+The provenance tests run against SQLite. The store is meant to run against PostgreSQL in a
+deployment, where NaN, floats, JSON and transactions are the server's, not SQLite's. These
+tests run only when ``TIA_TEST_POSTGRESQL_URL`` names a disposable PostgreSQL *server*
+(an asyncpg URL to its maintenance database); each test gets a database of its own, created
+and dropped here. Without the variable they are skipped: they never fall back to SQLite.
+"""
+
+from __future__ import annotations
+
+import math
+import os
+import uuid
+from datetime import UTC, datetime
+from typing import Any
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.engine import make_url
+
+from tests.integration.test_backtest_provenance import _row, _rows, _run, _save
+from tia.persistence import BacktestRepository, Database
+
+SERVER = os.environ.get("TIA_TEST_POSTGRESQL_URL")
+pytestmark = pytest.mark.skipif(not SERVER, reason="TIA_TEST_POSTGRESQL_URL names no disposable PostgreSQL server")
+
+
+@pytest.fixture
+async def pg():  # type: ignore[no-untyped-def]
+    admin = Database(SERVER or "")
+    name = "tia_store_" + uuid.uuid4().hex[:12]
+    async with admin.engine.connect() as conn:
+        await (await conn.execution_options(isolation_level="AUTOCOMMIT")).execute(text(f'CREATE DATABASE "{name}"'))
+    db = Database(make_url(SERVER or "").set(database=name).render_as_string(hide_password=False))
+    await db.create_schema()
+    assert db.dialect == "postgresql"
+    try:
+        yield db
+    finally:
+        await db.close()
+        async with admin.engine.connect() as conn:
+            await (await conn.execution_options(isolation_level="AUTOCOMMIT")).execute(text(f'DROP DATABASE "{name}"'))
+        await admin.close()
+
+
+def _same(stored: Any, sent: Any) -> bool:
+    if isinstance(sent, float) and math.isnan(sent):
+        return stored is None or (isinstance(stored, float) and math.isnan(stored))
+    return bool(stored == sent)
+
+
+async def test_what_is_stored_reads_back_identically_from_a_new_connection(pg: Database) -> None:
+    """Recovery: a result written by one engine is read back, number for number, by
+    another connection pool — floats exact, JSON lists intact, the timestamp's zone kept."""
+    row = _row(_run())
+    await _save(pg, row)
+    url = pg.engine.url.render_as_string(hide_password=False)
+    await pg.close()
+    reopened = Database(url)
+    try:
+        stored = (await _rows(reopened))[row["run_id"]]
+        for key in ("bars", "trades", "total_return_pct", "max_drawdown_pct", "sharpe", "equity_curve",
+                    "symbols", "warnings", "conditions"):
+            assert _same(getattr(stored, key), row[key]), key
+        assert stored.created_at == row["created_at"]
+    finally:
+        await reopened.close()
+
+
+async def test_a_rerun_with_an_undefined_ratio_replaces_only_itself(pg: Database) -> None:
+    """PostgreSQL keeps NaN as NaN (SQLite stores NULL): a re-run that carries NaN again is
+    still the same run, and replaces only itself."""
+    row = {**_row(_run()), "sharpe": float("nan")}
+    await _save(pg, row)
+    await _save(pg, {**row, "created_at": datetime(2026, 10, 22, 13, tzinfo=UTC)})
+    stored = await _rows(pg)
+    assert list(stored) == [row["run_id"]]
+    assert stored[row["run_id"]].created_at == datetime(2026, 10, 22, 13, tzinfo=UTC)
+
+
+async def test_a_rolled_back_save_leaves_nothing(pg: Database) -> None:
+    """Transactions: a save inside a transaction that fails afterwards is not kept."""
+    row = _row(_run())
+    with pytest.raises(RuntimeError, match="after the save"):
+        async with pg.session() as session:
+            await BacktestRepository(session).save(row)
+            raise RuntimeError("something failed after the save, inside the same transaction")
+    assert await _rows(pg) == {}
+
+
+async def test_a_refused_save_keeps_the_stored_row_and_the_store_usable(pg: Database) -> None:
+    """The provenance rule on PostgreSQL: another provenance under the same id is refused,
+    the first row is kept as it was, and the next save works."""
+    first = _row(_run())
+    await _save(pg, first)
+    other = {**first, "conditions": {**first["conditions"], "engine_version": "9.9.9"}, "trades": first["trades"] + 1}
+    with pytest.raises(ValueError, match="another provenance"):
+        await _save(pg, other)
+    kept = (await _rows(pg))[first["run_id"]]
+    assert kept.trades == first["trades"]
+    assert kept.conditions["engine_version"] == first["conditions"]["engine_version"]
+    await _save(pg, {**first, "created_at": datetime(2026, 10, 22, 14, tzinfo=UTC)})
+    assert (await _rows(pg))[first["run_id"]].created_at == datetime(2026, 10, 22, 14, tzinfo=UTC)
