+    def resting_orders(self, symbol: str | None = None) -> list[Order]:
+        """Orders still waiting in the book, in the order they will be matched."""
+        out = []
+        for order_id in self._resting:
+            order = self._orders.get(order_id)
+            if order is not None and not order.state.is_terminal and symbol in (None, order.symbol):
+                out.append(order)
+        return out
+
     async def get_positions(self) -> dict[str, Position]:
